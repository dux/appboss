<script>
  const GROUPS = [
    {
      title: 'Overview',
      topics: [
        { id: 'intro', title: 'What is dboss' },
        { id: 'how', title: 'How it works' },
        { id: 'config', title: 'Config files' },
        { id: 'cli', title: 'CLI' },
        { id: 'keys', title: 'Keys' },
      ],
    },
    {
      title: 'Features',
      topics: [
        { id: 'supervision', title: 'Supervision', summary: 'Runs every procfile process, checks it, restarts it and drains it on stop.' },
        { id: 'scaling', title: 'Rolling restart & scaling', summary: 'Restarts a running app without dropping a request, and runs several copies of a process.' },
        { id: 'idle', title: 'Idle stop & wake', summary: 'Stops apps nobody uses and starts them again on the next request.' },
        { id: 'routing', title: 'Routing', summary: 'Sends each hostname to the right app, with redirects, headers and maintenance mode.' },
        { id: 'access', title: 'Access control', summary: 'AuthCog sign-in, basic auth, IP allow lists and a Cloudflare-only origin.' },
        { id: 'static', title: 'Static files', summary: 'Serves CSS, JS, images and fonts from a folder on disk, at the same URL, without waking the app.' },
        { id: 'pages', title: 'Error pages', summary: 'Replaces server errors and every page dboss answers with, from one HTML template you can replace.' },
        { id: 'cron', title: 'Scheduled jobs', summary: 'One-shot commands on an interval or a cron expression.' },
        { id: 'add', title: 'Add from git', summary: 'Installs a repository that carries its own dboss.yaml from its URL.' },
        { id: 'hooks', title: 'Deploy hooks', summary: 'Commands a signed HTTP ping triggers, plus one-off exec.' },
        { id: 'lifecycle', title: 'Lifecycle', summary: 'Commands run when an app is created, started and destroyed.' },
        { id: 'previews', title: 'GitHub PR previews', summary: 'One built-in host hook turns a branch into a short-lived app, with teardown on close.' },
        { id: 'pubsub', title: 'PubSub', summary: 'Realtime channels over WebSocket and SSE on the app hosts.' },
        { id: 'audit', title: 'Audit & history', summary: 'Who did what, and every saved config revision.' },
        { id: 'health', title: 'Health & metrics', summary: 'Health endpoints, Prometheus metrics and the doctor preflight.' },
        { id: 'notify', title: 'Notifications', summary: 'One operator webhook for crashes and failures.' },
        { id: 'alerts', title: 'Alerts', summary: 'Posts to the webhook when an app answers with too many errors or too slowly.' },
        { id: 'postgres', title: 'PostgreSQL', summary: 'Inspect the host server, run SQL, and keep daily dumps for a week or a month.' },
      ],
    },
    {
      title: 'Logging',
      topics: [
        { id: 'logging', title: 'Logging', summary: 'Every channel dboss records per app - requests, stdout, app log files, blocked paths, traffic and events - and how retention keeps them bounded.' },
        { id: 'logs', title: 'Logs', summary: 'Requests, stdout and app log files in one searchable store per app.' },
        { id: 'traffic', title: 'Traffic', summary: 'Requests over time, error rate, latency and the top paths, countries and IPs per app.' },
        { id: 'events', title: 'Events', summary: 'Analytics from JSON log lines: counts, filters, tag facets, funnels and SQL over Parquet.' },
        { id: 'exceptions', title: 'Exceptions', summary: 'Error groups from a *.exceptions.log file, with per-minute counts, users and IPs.' },
        { id: 'blocked', title: 'Blocked requests', summary: 'Paths the deny rules refuse with 403, counted by path across every app.' },
      ],
    },
  ]

  // Fez trims every template line and decodes &lt;/&gt; into tags, so code samples live here
  // and reach db-preview-yaml as a prop.
  const EXAMPLES = {
    how: `
    browser -> Cloudflare -> dboss :80
                              | Host shop.example.com -> shop (PORT 3101)
                              | Host api.example.com  -> api  (PORT 3102)
    `,
    configHost: `
    apps: ./apps
    proxy:
      listen: ":80"
    ports: [3100, 3199]
    defaults:
      idle_stop: 30m
    `,
    configApp: `
    procfile:
      web:
        command: ./start.sh
        hosts: [shop.example.com]
        health: /up
    `,
    configDev: `
    procfile:
      web: bundle exec puma -e production
      web_dev: bundle exec puma -e development
    env:
      API_URL: https://api.example.com
      API_URL_dev: http://lvh.me:4000
    `,
    supervision: `
    procfile:
      web:
        command: bundle exec puma -p $PORT
        health: /up
      worker: bundle exec sidekiq
    autostart: false
    health_timeout: 90s
    processes:
      worker:
        stop_timeout: 120s
    `,
    scaling: `
    procfile:
      web:
        command: bundle exec puma -p $PORT
        hosts: [shop.example.com]
        health: /up
        count: 3
      worker:
        command: bundle exec sidekiq
        count: 2
    `,
    idle: `
    # host file: every app sleeps after 30 minutes
    defaults:
      idle_stop: 30m

    # app file: this one never sleeps
    idle_stop: 0s
    `,
    routing: `
    procfile:
      web:
        command: ./start.sh
        hosts:
          - shop.example.com
          - www.shop.example.com
        canonical_host: shop.example.com
    max_body: 50m
    headers:
      X-Frame-Options: DENY
    `,
    access: `
    # app file, or under defaults: in the host file
    auth: [ana@example.com, "*@example.com"]
    session_ttl: 24h
    basic_auth:
      alice: "$2a$10$..."   # dboss password
      bob: secret           # plain password
    allow_ips:
      - 10.0.0.0/8
    deny:
      - "*.php"
      - /admin/*

    # host file
    proxy:
      cloudflare: true
    `,
    static: `
    procfile:
      web:
        command: ./start.sh
        hosts: [shop.example.com]

    # ./public by default; a path, or false to disable. Served at the same URL,
    # so public/foo/bar.png answers /foo/bar.png.
    static: ./public
    static_immutable: [/assets/, /packs/]
    `,
    pages: `
    procfile:
      web:
        command: ./start.sh
        hosts: [shop.example.com]

    # The folder dboss reads its pages from; ./public/error_pages by default.
    pages: ./public/error_pages
    `,
    pagesTemplate: `
    <!doctype html>
    <title>{{title}}</title>
    <img src="{{dboss_logo}}" alt="">
    <h1>{{status}} - {{title}}</h1>
    <p>{{message}}</p>
    {{action}}
    `,
    pagesCli: `
    dboss pages shop                  # which file serves each page
    dboss pages dump shop             # write template.html to edit
    dboss pages dump shop error       # write error.html with its wording
    dboss pages dump --all            # the host template and every page
    `,
    blocked: `
    # app dboss.yaml, or defaults: in the host file
    deny:
      - "*.php"
      - /admin/*
      - /.git/*
      - /.env
    `,
    logging: `
    # host dboss.yaml
    dir: /var/lib/dboss        # state/, log/ and the control socket live here
    log_level: info            # dboss's own log level
    maintenance_at: "04:10"    # daily prune, then SQLite VACUUM

    # app dboss.yaml, or defaults: in the host file
    log_retention: 336h        # request rows and app log files
    stdout_retention: 3h       # process stdout and the dboss daemon log
    events:
      retention: 90d           # raw events from log/*.json.log
    `,
    logs: `
    log_retention: 168h
    stdout_retention: 12h
    `,
    logsCli: `
    dboss logs -f shop
    dboss logs shop --process worker -n 500
    dboss logs shop --search timeout --level error --channel stdout
    `,
    exceptionsLine: `
    # one compact JSON object per line in log/app.exceptions.log
    {"exp_uid":"<sha256>","dump":"...","message":"boom","user":"u_42","ip":"203.0.113.7","tags":["checkout"],"ts":"2026-09-26T10:00:30.123Z"}
    `,
    cron: `
    cron:
      cleanup:
        schedule: every 6h
        command: bundle exec rake cleanup
        timeout: 30m
        overlap: false
    `,
    add: `
    dboss add https://github.com/acme/shop
    dboss add acme/shop --name store --host store.box.example.com
    dboss add git@gitlab.com:acme/api.git --branch production
    `,
    hooks: `
    hooks:
      deploy:
        command: git -C .. pull --ff-only
        timeout: 10m
        restart: true
        overlap: false
    `,
    previews: `
    # host file: one built-in hook, github_pr
    tokens:
      github: $GITHUB_TOKEN   # pulls a private repo
      dboss: $DBOSS_TOKEN     # every ping presents it
    hooks:
      github_pr:
        repo: https://github.com/owner/repo.git   # fallback when the ping omits repo
        template:
          name: $QS_BRANCH
          hosts: [pr-$QS_BRANCH.example.com]
          autostart: false
          deletable: true
          lifecycle:
            create: bin/setup-db     # once, before the first start
            destroy: bin/drop-db     # when the PR closes
          procfile:
            web: {command: ./start.sh, health: /up}
    `,
    lifecycle: `
    # in the app's dboss.yaml
    lifecycle:
      create: bin/setup-db              # once, before the first start
      start:                            # before every start; processes wait for it
        command: bundle exec rake db:migrate
        timeout: 10m
      destroy: bin/drop-db              # after dboss destroy stops the app
    `,
    previewsPing: `
    curl -fsS -X POST "https://dboss.example/hooks/github_pr?token=\${{ secrets.DBOSS_TOKEN }}&action=\${{ github.event.action }}&branch=\${{ github.head_ref }}&repo=\${{ github.event.pull_request.head.repo.clone_url }}&num=\${{ github.event.number }}"
    `,
    pubsub: `
    procfile:
      web:
        command: ./start.sh
        hosts: [shop.example.com]
        pubsub:
          path: /socketio
          replay: 10
          client_events: true
          test: false
    `,
    pubsubSubscribe: `
    <script src="/socketio/client.js"><\/script>
    <script>
      const chat = Pubsub.connect({ path: '/socketio' }).channel('chat');
      chat.on('message', (envelope) => console.log(envelope.event, envelope.data));
      chat.on('open', () => chat.send('typing', { user: 'a' }));
    <\/script>
    `,
    pubsubPublish: `
    curl -X POST https://myapp.example.com/socketio/chat \\
      -H "Authorization: Bearer $PUBSUB_SECRET" \\
      -d '{"event":"message","data":{"text":"hello"}}'
    `,
    audit: `
    audit_retention: 30d   # 0 keeps rows forever
    `,
    health: `
    # host file: /metrics needs this as a bearer token
    tokens:
      dboss: $DBOSS_TOKEN

    # app file
    health_endpoint: /healthz
    `,
    alerts: `
    # host file: every app, 5% errors or a 2s p95
    defaults:
      alerts:
        error_rate: 5
        slow_p95: 2s

    # app file: this one only checks latency
    alerts:
      error_rate: 0
    `,
    eventsLine: `
    {"msg": "Checkout completed", "tags": ["beta", "plan:pro"],
     "data": {"event": "checkout_completed", "user_id": "u_42", "tenant_id": "s_7", "value": 49.9, "coupon": "X"}}
    `,
    eventsFilter: `
    checkout_completed                  one event (a,b for either, checkout_* for a prefix)
    plan:pro  plan:  #beta              a tag pair, any value of a key, a label
    user=u_42  tenant=s_7  country=HR   fixed columns (also anon=, ns=, req=)
    value>10  data.items>=3             the value, a key left in data
    "timeout"  -#internal  since=7d     text in msg, a negated term, the time range
    `,
    events: `
    events:
      retention: 90d
      views:
        pro_checkouts: "checkout_completed plan:pro"
      funnels:
        checkout:
          by: user
          window: 7d
          breakdown: plan
          steps:
            - {name: Pricing, filter: "page_view page:pricing"}
            - {name: Started, filter: "checkout_started"}
            - {name: Paid, filter: "checkout_completed value>0"}
    `,
    notify: `
    notify:
      url: $ALERT_WEBHOOK_URL
      events: [crash, restart-loop, health-timeout, wake-failed]
    `,
    postgres: `
    postgres:
      backups:
        myapp_production: week   # keep 7 days; month keeps 30
        reports: month
    `,
  }

  class {
    init() {
      this.state.topic = Fez.hqs('topic') || 'intro'
      this.state.groups = GROUPS
      this.state.examples = EXAMPLES
    }

    select(id) {
      this.state.topic = id
      Dboss.setQs('topic', id === 'intro' ? '' : id)
      if (this.state.pane) this.state.pane.scrollTop = 0
    }
  }
</script>

<div class="page-header">
  <div>
    <p class="page-pretitle">Help</p>
    <h1 class="page-title">Operator guide</h1>
  </div>
  <div class="page-actions">
    <button class="btn" type="button" onclick="Drawer.showReference()">
      <svg class="icon"><use href="#i-book"></use></svg>
      Annotated reference
    </button>
  </div>
</div>

<div class="card help">
  <nav class="list-group help-nav" aria-label="Help topics">
    {#each state.groups as group}
      <div class="help-nav-title">{group.title}</div>
      {#each group.topics as topic}
        <button class="list-group-item" class:active={topic.id === state.topic} type="button" onclick="fez.select('{topic.id}')">
          <strong>{topic.title}</strong>
        </button>
      {/each}
    {/each}
  </nav>

  <div class="help-body" fez:this="pane">
    {#if state.topic === 'intro'}
      <section>
        <h2>What is dboss</h2>
        <p>dboss is one binary that runs the apps on one host. It starts and supervises their processes, owns port 80 and routes each hostname to the right app, keeps their logs searchable, and serves this console and a CLI over the same actions.</p>
        <p>Cloudflare is the edge: TLS, caching, compression and WAF live there. Releases are the deploy tool's job. Everything in between is configured with plain <code>dboss.yaml</code> files on disk, one for the host and one per app.</p>
        {#each state.groups as group}
          {#unless group.title === 'Overview'}
            <h3>{group.title}</h3>
            <div class="help-index">
              {#each group.topics as feature}
                <div class="help-cmd">
                  <a class="help-jump" onclick="fez.select('{feature.id}')">{feature.title}</a>
                  <span>{feature.summary}</span>
                </div>
              {/each}
            </div>
          {/unless}
        {/each}
        <h3>Around the features</h3>
        <ul>
          <li>Management console with live state, start, stop, restart and maintenance controls, a validated config editor, logs, audit and help.</li>
          <li>The Sys tab inspects the host read-only: OS, kernel, public IP, load, memory, disks, the running dboss build against the latest GitHub release, and the installed toolchains (Node, npm, Bun, Ruby, Python and more) with their versions.</li>
          <li>AuthCog sign-in for admins, plus one-time <code>dboss login</code> links over the control socket for local work.</li>
          <li>Full CLI over the control socket, with <code>--json</code> on every command.</li>
          <li>Validate with <code>dboss check</code>, inspect with <code>dboss config [app] -d</code>, browse every key under Keys or in the annotated reference.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'how'}
      <section>
        <h2>How it works</h2>
        <p>One <code>dboss</code> process owns the ports, the proxy and the console. Each app is a folder with an <code>dboss.yaml</code>; its <code>procfile</code> maps a process name to a command. Dboss gives every process a fixed <code>PORT</code> and routes each request to the app whose <code>hosts</code> match.</p>
        <ul>
          <li>A stopped app starts on the first request and answers with a starting page that refreshes.</li>
          <li>An idle app stops after <code>idle_stop</code> and wakes the same way.</li>
          <li>Stop and restart drain first: new requests get <code>503</code> while those in flight finish, bounded by <code>stop_timeout</code>.</li>
          <li>Every mutating action is written to the audit log, and crash and failure events can post to one operator webhook.</li>
          <li>Cloudflare is the edge: TLS, caching, compression and WAF live there. dboss is the origin and trusts only Cloudflare's ranges.</li>
        </ul>
        <db-preview-yaml :text="state.examples.how" lang="text" />
      </section>
    {/if}

    {#if state.topic === 'config'}
      <section>
        <h2>Config files</h2>
        <p><code>dboss.yaml</code> has two roles. A file with <code>apps:</code> is a host; a file with <code>procfile:</code> is an app. Never both. <code>dboss.local.yaml</code> next to a host file wins over it, is gitignored, and is where server-only values (secrets, admin emails, absolute paths) live. Either file may also sit in the folder's <code>config/</code> subfolder; paths still resolve against the folder itself, and files in both places are an error.</p>
        <p><code>defaults:</code> in the host file applies to every app. An app's top-level key overrides it key by key, and <code>processes.&#60;name&#62;</code> overrides it once more for a single process.</p>
        <p>A <code>$NAME</code> in a value is replaced from the daemon's environment before it loads, so <code>url: $ALERT_WEBHOOK_URL</code> keeps the secret out of the file. Only all-uppercase names expand, an unset name is left as written, and <code>procfile</code> and cron commands are never expanded because they are runtime shell lines.</p>
        <h3>Host</h3>
        <db-preview-yaml :text="state.examples.configHost" />
        <h3>App</h3>
        <db-preview-yaml :text="state.examples.configApp" />
        <h3>Dev values</h3>
        <p>Any key can be written twice, once with a <code>_dev</code> suffix. A dev session - one app run from its own folder, <code>dboss s</code> where the config file has <code>procfile</code> - takes the <code>_dev</code> value; every other session drops it, so one committed app file serves both.</p>
        <db-preview-yaml :text="state.examples.configDev" />
        <p>The suffix works at every depth and inside free-form maps such as <code>procfile</code>, <code>env</code> and <code>headers</code>. The value replaces the base key outright, so a block override names the leaf key it changes (<code>proxy.listen_dev</code>) rather than restating the block. A <code>&#60;key&#62;_dev</code> is checked against the schema in both modes, so a typo is still caught by <code>dboss check</code> on the host.</p>
        <p>A dev session also gets this console on a free loopback port it claims from <code>ports</code>, with no <code>management</code> block, and a request coming from that machine is signed in without <code>dboss login</code>, so <code>management.admins</code> is not needed either. The check is the connecting address and never a forwarded-for header, so an app run this way does not belong behind a reverse proxy on the same box.</p>
        <p><code>dboss start --https</code> runs a dev session on <code>:80</code> and <code>:443</code>, with certificates from a local certificate authority kept in your user config directory. Without it the session serves plain http on a free port. The first <code>--https</code> start asks whether to trust that authority, and <code>dboss trust</code> does it any time, so the browser accepts the certificates.</p>
      </section>
    {/if}

    {#if state.topic === 'supervision'}
      <section>
        <h2>Supervision</h2>
        <p>Each key under <code>procfile</code> is a process type, and dboss runs all of them as one group per app. It gives every process a fixed <code>PORT</code>, waits for each web process to pass its health check, keeps checking it, and restarts what exits or stops answering.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Running a web process next to its workers without a separate process manager or a systemd unit per app.</li>
          <li>Bringing back exactly the apps that were up after a host restart (<code>autostart</code> and <code>running.json</code>).</li>
          <li>Recovering from a crashed or hung web process on its own, with backoff, and marking the app <code>crashed</code> with an alert when it keeps failing.</li>
          <li>Restarting without downtime: a running app rolls onto new copies (see <a href="#/help?topic=scaling">Rolling restart &amp; scaling</a>), and a stop answers new requests with <code>503</code> while those in flight finish within <code>stop_timeout</code>.</li>
          <li>Capping one app's memory and CPU on a shared box (cgroup v2; process groups elsewhere ignore the limits).</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-supervision"><db-config-keys paths="procfile,autostart,processes,health_timeout,liveness_interval,unhealthy_threshold,restart,max_restarts,stop_timeout,stop_signal,env,memory_max,cpu_max" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.supervision" />
        <h3>Details</h3>
        <p>All process types run at once; every process that declares <code>hosts</code> is a web process and gets proxied traffic on those hosts. An app may run several web processes, each with its own hosts, health check, canonical host and realtime hub. They start first, then the rest by name. A process with no <code>hosts</code> is background-only. Dboss injects <code>PORT</code> (fixed per app, process and copy), <code>APP_NAME</code>, <code>PROC_TYPE</code>, <code>PROC_INSTANCE</code> and <code>DBOSS_SOCKET</code> into every process.</p>
        <ul>
          <li><code>autostart: false</code> keeps an app down until <code>dboss run</code>, the console, or a request starts it. <code>autostart: button</code> is the same, except a request answers a start button and only its POST starts the app, so crawler and favicon GETs never do.</li>
          <li><code>health</code> on a web process is the readiness check: a path such as <code>/up</code> that must answer 2xx, or omit it for a plain TCP connect. A process that never passes it within <code>health_timeout</code> is restarted.</li>
          <li>While a web process starts it is polled every 500ms; once ready the check keeps running every <code>liveness_interval</code>, and <code>unhealthy_threshold</code> consecutive failures restart it (<code>0</code> disables the ongoing check). Workers are not polled.</li>
          <li>Restarts follow <code>restart</code> and <code>max_restarts</code>, backing off from 1s and doubling up to 60s; after that many consecutive failures the app is <code>crashed</code>. A minute of uptime clears the counter.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'scaling'}
      <section>
        <h2>Rolling restart &amp; scaling</h2>
        <p>Restarting a running app never takes it down: dboss starts a new copy of each web process next to the old one, moves traffic over once the new copy passes its health check, and only then drains and stops the old one. <code>count</code> on a procfile entry runs several copies of it, and the proxy balances requests across the ready ones.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Deploying without a gap: <code>dboss restart</code>, the console and a <code>restart: true</code> deploy hook all roll a running app.</li>
          <li>Surviving a bad release: a new copy that crashes or never gets healthy is killed, the old one keeps serving, and <code>health-timeout</code> reports it.</li>
          <li>Using more than one core with a single-threaded server, and keeping an app up when one copy dies.</li>
          <li>Running several queue workers from one procfile line.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-scaling"><db-config-keys paths="procfile,health_timeout,stop_timeout" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.scaling" />
        <h3>Details</h3>
        <ul>
          <li>Copies are named <code>web.1</code> .. <code>web.3</code> in the console, logs and metrics; a single copy keeps the bare name. Each has its own <code>PORT</code> and <code>PROC_INSTANCE</code> (1..count).</li>
          <li>A web process gets one spare port on top of its copies. A restart replaces the copies one at a time through it, so the port a copy listens on changes between restarts.</li>
          <li>The proxy sends each request to the ready copy with the fewest requests in flight. A retired copy leaves the route before it drains, so no new request reaches it; it gets <code>stop_timeout</code> to finish, then its <code>stop_signal</code>, then a kill.</li>
          <li>The <code>start</code> lifecycle step runs before the copies roll; if it fails nothing is replaced.</li>
          <li>Background processes are stopped and started again, never run twice at once, so a scheduler cannot double up.</li>
          <li>The restart returns once every copy is replaced, or with the error when it aborted. A changed <code>count</code> applies on the next restart. A stopped or crashed app restarts the plain way.</li>
          <li>One copy that exits is restarted on its own; the app only reads <code>starting</code> or <code>crashed</code> when no copy of a web process is left serving.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'idle'}
      <section>
        <h2>Idle stop &amp; wake</h2>
        <p>An app with no proxied traffic for <code>idle_stop</code> is stopped. The next request to one of its hosts starts it again and answers with a starting page that refreshes until the app is healthy.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Fitting many staging, preview or rarely used apps on one box: only the ones in use hold memory.</li>
          <li>Keeping crawlers and scanners from waking apps: <code>autostart: button</code> starts only on the start button's POST, and a request that fails <code>basic_auth</code> never reaches the wake stage.</li>
          <li>Giving visitors a clear page instead of an error while an app boots, with <code>Retry-After</code> for API clients.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-idle"><db-config-keys paths="idle_stop,autostart,pages" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.idle" />
        <h3>Details</h3>
        <ul>
          <li>Idle apps are checked every minute; <code>idle_stop</code> is off (<code>0s</code>) unless an app or <code>defaults</code> sets it.</li>
          <li>A stopped app gets the <code>starting</code> page, which reloads every 5 seconds until the app is healthy. A crashed app gets the <code>crashed</code> page. Both are <a href="#/help?topic=pages">pages</a> you can replace.</li>
          <li>Static files, the health endpoint and PubSub are served by dboss itself and never wake the app.</li>
          <li>A wake that fails posts <code>wake-failed</code> to the operator webhook; explicit starts from the CLI or console do not.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'routing'}
      <section>
        <h2>Routing</h2>
        <p>Each web process lists the hostnames it answers in <code>hosts</code>. The proxy reads the request <code>Host</code>, picks the app, then forwards to the web process that owns that host. Background processes never get traffic.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Hosting many sites on one port 80 without writing an nginx vhost per app.</li>
          <li>Wildcard and tenant subdomains: <code>*.</code> for subdomains, <code>.example.com</code> for the apex plus every subdomain.</li>
          <li>One canonical address: <code>canonical_host</code> 301s <code>www</code> and every other host to it.</li>
          <li>Taking an app out of service with a maintenance page while it keeps running.</li>
          <li>Adding or removing response headers and limiting the request body for every response, without touching the app.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-routing"><db-config-keys paths="headers,max_body,proxy.listen,proxy.timeout" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.routing" />
        <h3>Details</h3>
        <p>A leading <code>*.</code> matches subdomains only; a leading <code>.</code> matches the bare domain and every subdomain, so <code>hosts: .example.com</code> is <code>example.com</code> plus <code>*.example.com</code>. A single value is accepted like a list, and in single-app dev mode a process with no hosts is bound to <code>.lvh.me</code>.</p>
        <p><code>maintenance on</code> answers every request with the maintenance page while the app keeps running. A stopped app gets the starting page, then the real response once it is healthy. A host no app matches gets the host's <code>404</code> page.</p>
        <p>Each request walks the stages in this order: canonical redirect, <code>allow_ips</code>, <code>deny</code>, health endpoint, <code>auth</code> sign-in, <code>basic_auth</code>, maintenance, static files, body buffer, then wake or forward. Forwarded headers (<code>X-Forwarded-Proto</code>, <code>X-Forwarded-Host</code>, <code>X-Real-IP</code>) are added only when missing, so Cloudflare's values win.</p>
      </section>
    {/if}

    {#if state.topic === 'access'}
      <section>
        <h2>Access control</h2>
        <p>Three app-level gates, <code>auth</code>, <code>basic_auth</code> and <code>allow_ips</code>, run in the proxy before the app sees a request. One host key, <code>proxy.cloudflare</code>, makes sure the origin only talks to Cloudflare and reads the real client IP from it. A fourth app-level feature, <code>authcog</code>, runs the AuthCog sign-in for an app that has no auth code of its own.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Letting only named people into an app: <code>auth</code> asks for an AuthCog sign-in and admits the listed emails, the way Cloudflare Access does.</li>
          <li>Giving an app a sign-in it does not implement: <code>authcog</code> runs the whole AuthCog round trip and hands the app the profile once.</li>
          <li>Putting a password in front of a whole staging box with one <code>basic_auth</code> block under <code>defaults:</code>.</li>
          <li>Limiting an admin or internal app to office and VPN addresses.</li>
          <li>Making sure nobody bypasses Cloudflare's WAF and rate limits by hitting the origin directly.</li>
          <li>Keeping protected sleeping apps asleep: a request without valid credentials never wakes them.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-access"><db-config-keys paths="auth,session_ttl,authcog,authcog_realm,basic_auth,allow_ips,deny,proxy.cloudflare" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.access" />
        <h3>Details</h3>
        <p><code>auth</code> sends a visitor without a session to AuthCog (<code>authcog_realm</code>). They return to <code>/.well-known/dboss/auth</code> and get a signed, host-only cookie that lasts <code>session_ttl</code>; <code>/.well-known/dboss/logout</code> signs out. The list takes exact addresses, <code>*@domain</code> patterns and <code>"*"</code> for any account, and is checked on every request, so removing an entry ends that session on the next rescan.</p>
        <p><code>authcog</code> is a login service, not a gate: <code>authcog: true</code> (the path <code>/authcog</code>) or <code>authcog: /path</code>. The app links to that path, dboss signs the visitor in and then forwards one request to that path with the profile in <code>X-Dboss-User</code>, and the app reads it and creates its own session. Any AuthCog account is admitted, logout is the app's job, and the login path is never gated by <code>auth</code>.</p>
        <ul>
          <li>The app receives the signed-in email as <code>X-Dboss-User</code>. dboss removes that header from every inbound request, so the app can trust it.</li>
          <li>A request that does not accept <code>text/html</code> gets <code>401</code> instead of a redirect.</li>
          <li>A session is issued for one app: it opens neither another app nor the console.</li>
          <li><code>basic_auth</code> is independent: when both are set, both must pass.</li>
        </ul>
        <p><code>basic_auth</code> puts HTTP basic auth in front of the whole app, static files included. It maps a user to a plain password or a bcrypt hash printed by <code>dboss password</code>. <code>allow_ips</code> limits the app to a list of CIDRs (address ranges such as <code>10.0.0.0/8</code>), matched against the client address. <code>deny</code> refuses paths with <code>403</code> before the app is contacted: <code>*.php</code> matches any path ending in <code>.php</code>, <code>/admin/*</code> the path and its subtree, and a plain <code>/path</code> is exact, all case-insensitive.</p>
        <p><code>proxy.cloudflare: true</code> accepts connections only from Cloudflare's published ranges, built into dboss, and from the box itself; anything else gets <code>403</code>. The client address then comes from <code>CF-Connecting-IP</code>, which only Cloudflare can set. Without it the client address is the connection's own.</p>
        <ul>
          <li>A request with no or wrong credentials, or without a sign-in session, stops at the auth stage and never reaches the wake stage, so a crawler or scanner cannot start a protected sleeping app. The first request with valid credentials wakes it.</li>
          <li>With no <code>basic_auth</code> any request wakes a stopped app, except an <code>autostart: button</code> app, which only its start button's POST wakes.</li>
          <li>The health endpoint answers before auth, so a Cloudflare health check works on a protected app. It never wakes the app.</li>
          <li>A pubsub publisher presenting the app's publish secret passes without the basic-auth credentials or a sign-in session.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'static'}
      <section>
        <h2>Static files</h2>
        <p>Each app serves one folder straight from disk, at the same URL, without waking the app. Put <code>public/foo/bar.png</code> in the repo and the proxy answers <code>/foo/bar.png</code> from disk, so CSS, JS, images and fonts never spend an app worker.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Serving CSS, JS, images and fonts without spending app workers, and without waking a stopped app.</li>
          <li>Year-long immutable caching for fingerprinted asset folders, so Cloudflare and browsers keep them.</li>
          <li>One folder to drop a build into: the path on disk is the path in the URL.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-static"><db-config-keys paths="static,static_extensions,static_immutable" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.static" />
        <h3>Details</h3>
        <ul>
          <li><code>static</code> is the folder, relative to the app (<code>./public</code> by default). <code>static: false</code> disables serving; another path, e.g. <code>./assets</code>, serves that folder instead.</li>
          <li>With no config, serving is on when a <code>public/</code> folder exists and off when it does not, so nothing has to be declared for the common case.</li>
          <li>Only GET and HEAD are answered; every other method reaches the app. Only the extensions in <code>static_extensions</code> are served, and an empty list serves any regular file.</li>
          <li>A missing file, a directory, an <code>.html</code> page, a dotfile or an extensionless path reaches the app, so a route always wins over a stray file. No index lookup.</li>
          <li>Lookups stay inside the folder, so <code>..</code> cannot escape it. A release symlink swap is picked up on the next request.</li>
          <li>Paths under <code>static_immutable</code> (default <code>/assets/</code>) get <code>Cache-Control: public, max-age=31536000, immutable</code>; everything else gets an hour.</li>
          <li>Static files sit behind <code>auth</code>, <code>basic_auth</code>, <code>allow_ips</code> and <code>deny</code>, so a protected app protects its assets too.</li>
          <li>For the pages dboss serves, including server errors, see <a href="#/help?topic=pages">Error pages</a>.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'pages'}
      <section>
        <h2>Error pages</h2>
        <p>Every page dboss answers with itself is built in and can be replaced with your own HTML: the server error page for a <code>502</code> and for an app's own <code>5xx</code>, plus starting, stopped, crashed, maintenance, forbidden, blocked, signed out, and on the host the <code>404</code> and the console login.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>One branded server error page instead of a bare <code>502</code> or the app's own error body.</li>
          <li>One branded template for every page dboss shows, per app or for the whole host, while API clients still get the bare status.</li>
          <li>Replacing the app's own <code>5xx</code> body with the same page.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-pages"><db-config-keys paths="pages" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.pages" />
        <h3>Template</h3>
        <db-preview-yaml :text="state.examples.pagesTemplate" lang="text" />
        <h3>Details</h3>
        <p>For each page dboss reads, on every request, the first of: <code>&#60;name&#62;.html</code> in the app's <code>pages</code> folder (default <code>./public/error_pages</code>), <code>template.html</code> there, the same two in the host's <code>pages</code> folder, then the built-in template. So one <code>template.html</code> covers every page.</p>
        <p>A page fills these tokens and leaves any other <code>&#123;&#123;...&#125;&#125;</code> alone: <code>&#123;&#123;status&#125;&#125;</code>, <code>&#123;&#123;title&#125;&#125;</code>, <code>&#123;&#123;message&#125;&#125;</code>, <code>&#123;&#123;action&#125;&#125;</code> (the start button or sign-in link dboss builds), <code>&#123;&#123;app&#125;&#125;</code> and <code>&#123;&#123;dboss_logo&#125;&#125;</code> (the dboss mark, served at <code>/.well-known/dboss/logo.svg</code> on every host). Pages go only to a GET that accepts <code>text/html</code>; everything else gets the bare status.</p>
        <ul>
          <li>dboss's own errors (<code>502</code> when the app is unreachable, timed out or has no port) always render the <code>error</code> page.</li>
          <li>The app's own <code>5xx</code> answers are replaced with the <code>error</code> page, status kept, only when the app's pages folder has <code>error.html</code> or <code>template.html</code>. An app that ships no pages keeps its own error bodies.</li>
          <li>An app's own <code>404</code>s are never touched; the host <code>404</code> page is only for a host no app owns.</li>
        </ul>
        <db-preview-yaml :text="state.examples.pagesCli" lang="text" />
      </section>
    {/if}

    {#if state.topic === 'logging'}
      <section>
        <h2>Logging</h2>
        <p>Every app gets its own store at <code>dir/log/&#60;app&#62;/dboss.sqlite</code>, holding its requests, process output and app log files; analytics events live next to it as Parquet. The daemon log and the operator audit live in the reserved <code>_dboss</code> database. The <a href="#/help?topic=logs">Logs</a>, <a href="#/help?topic=traffic">Traffic</a>, <a href="#/help?topic=events">Events</a> and <a href="#/help?topic=exceptions">Exceptions</a> tabs, the full-screen viewer at <code>/logs</code> and <code>dboss logs</code> all read the same data.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Finding one failing request or reading what a process printed, without an SSH session.</li>
          <li>Counting what users do, from the JSON lines the app already writes, with no analytics service to run.</li>
          <li>Seeing scrapers and attacks turned away, and how much traffic each denied path accounts for.</li>
          <li>Bounded disk use: a retention per channel, size-based rotation, a daily prune and SQLite <code>VACUUM</code>.</li>
        </ul>
        <h3>Channels</h3>
        <ul>
          <li><code>REQUEST</code> - one row per proxied request: method, path, status, duration, bytes, country and Cloudflare Ray ID. There is one per web process.</li>
          <li><code>STDOUT</code> - the stdout and stderr of every process, one channel per process, with the port in the label.</li>
          <li><code>dboss</code> - the daemon's own log, in the reserved <code>_dboss</code> database, shared by the whole host.</li>
          <li>One channel per <code>*.log</code> file under the app's <code>./log</code> folder, plus <code>cron-&#60;job&#62;</code>, <code>hook-&#60;name&#62;</code> and <code>lifecycle-&#60;step&#62;</code> for the commands dboss runs.</li>
          <li><code>&#60;ns&#62;.json.log</code> is not a plain log: it is an <a href="#/help?topic=events">event</a> namespace, stored as Parquet per namespace and day.</li>
          <li><a href="#/help?topic=blocked">Blocked requests</a> are not process output: each <code>deny</code> hit is counted by path in the <code>_dboss</code> database and kept forever.</li>
        </ul>
        <h3>Console views</h3>
        <ul>
          <li><a href="#/help?topic=logs">Logs</a> - full-text search and a time range over every channel, with level, method and status filters, a per-row detail view, copy and a text export. A Cloudflare Ray ID can be pasted as the query.</li>
          <li><a href="#/help?topic=traffic">Traffic</a> - requests over time, error rate, latency quantiles and the top paths, countries and clients, aggregated from the request rows.</li>
          <li><a href="#/help?topic=events">Events</a> - counts, filters, tag facets, funnels and SQL over the app's Parquet files.</li>
          <li><a href="#/help?topic=blocked">Blocked requests</a> (<code>#/blocked</code>, from the Logs page) - the denied paths across every app, biggest first, capped at 200.</li>
          <li><a href="#/help?topic=audit">Audit</a> - who did what, in the reserved <code>_dboss</code> database, with its own retention.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-logging"><db-config-keys paths="log_retention,stdout_retention,events.retention,audit_retention,log_level,maintenance_at,dir,deny" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.logging" />
        <h3>Details</h3>
        <ul>
          <li><code>log_retention</code> (default <code>336h</code>, two weeks) covers request rows and app log files; <code>stdout_retention</code> (default <code>3h</code>) covers stdout and the daemon log. <code>0</code> turns a channel off, and <code>log_retention: 0</code> disables the whole store for the app, so it has no request log, no traffic and no events either.</li>
          <li><code>events.retention</code> (default <code>365d</code>) removes only the raw Parquet days; the daily counts and tag facets stay.</li>
          <li><code>log_level</code> is dboss's own level: <code>debug</code>, <code>info</code>, <code>warn</code> or <code>error</code>. The log always goes to stderr, so it is the terminal in the foreground and journald under systemd.</li>
          <li><code>dir</code> is the runtime directory; every store lives under its <code>log/</code>. Keep it on a filesystem with room for the retention you choose.</li>
          <li><code>maintenance_at</code> (default <code>04:10</code>) is the one daily housekeeping time: the prune runs first, then SQLite <code>VACUUM</code> on every app database and the host database. Run it off peak, since the vacuum rewrites each file.</li>
          <li>Process log files rotate at 10m and keep five rotated files; stdout retention is what bounds the copied segments. App <code>*.log</code> files are app-owned: dboss tails them and advances an offset, never deletes or renames them.</li>
          <li><code>deny</code> refuses paths before the app is contacted and counts each hit under <a href="#/help?topic=blocked">Blocked requests</a>. The list and its patterns are in <a href="#/help?topic=access">Access control</a>.</li>
          <li><code>log_retention</code>, <code>stdout_retention</code> and <code>events.retention</code> are app keys; <code>dir</code>, <code>log_level</code>, <code>audit_retention</code> and <code>maintenance_at</code> are host keys that need a daemon restart.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'logs'}
      <section>
        <h2>Logs</h2>
        <p>Each app has one SQLite store at <code>dir/log/&#60;app&#62;/dboss.sqlite</code> holding its requests, process output and app log files. The full-screen viewer at <code>/logs</code> and <code>dboss logs</code> read the same data.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Finding one failing request: full-text search over messages and raw lines, with level and request filters. A Cloudflare Ray ID can be pasted as is.</li>
          <li>Reading stdout, the app's own <code>*.log</code> files and the request log in one place, without SSH.</li>
          <li>Sharing what you found: the viewer URL carries the filters, and rows export.</li>
          <li>Bounded disk use: rotation, retention per channel, a daily prune and SQLite <code>VACUUM</code>.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-logs"><db-config-keys paths="log_retention,stdout_retention,dir,maintenance_at,log_level" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.logs" />
        <h3>Details</h3>
        <ul>
          <li><code>REQUEST</code> - one row per proxied request, with the visitor country from Cloudflare. Search also matches the request id, so a Cloudflare Ray ID can be pasted.</li>
          <li><code>STDOUT</code> - the stdout and stderr of each process.</li>
          <li><code>dboss</code> - the daemon's own log.</li>
          <li>one channel per <code>*.log</code> file under the app's <code>log/</code> folder.</li>
        </ul>
        <p><code>log_retention</code> (default two weeks) covers requests and app log files; <code>stdout_retention</code> (default three hours) covers stdout and the daemon log. <code>log_retention: 0</code> turns the store off for the app. The daily prune runs at <code>maintenance_at</code> (default 04:10) and is followed by SQLite <code>VACUUM</code> on every store. Process log files rotate at 10m and keep five rotated files.</p>
        <db-preview-yaml :text="state.examples.logsCli" lang="text" />
        <p>With <code>--search</code>, <code>--level</code> or <code>--channel</code> the command queries the store instead of tailing files.</p>
      </section>
    {/if}

    {#if state.topic === 'exceptions'}
      <section>
        <h2>Exceptions</h2>
        <p>An app that writes <code>log/&#60;app&#62;.exceptions.log</code> gets an Exceptions tab. The Lux <code>web_common</code> plugin writes that file automatically from <code>Lux.error.log</code>, but any producer may append the same JSON lines. dboss tails it like any app log and groups the occurrences instead of storing one row each.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Seeing which errors actually happen, newest and most frequent first, without a database-backed error tracker.</li>
          <li>One row per fingerprint rather than one per crash: a loop throwing 44,000 times is still one exception and ten minute rows.</li>
          <li>Who it hit: the distinct user refs and client IPs per minute, capped at five each.</li>
          <li>Seeing it at a glance: the app card's Exceptions button turns red with the count while any group is unresolved.</li>
          <li>Bounded storage: only the per-minute counts age out; the fingerprint, its first dump and the totals stay.</li>
        </ul>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.exceptionsLine" lang="text" />
        <h3>Details</h3>
        <ul>
          <li><code>exp_uid</code> (nonempty) and <code>message</code> are required; <code>dump</code>, <code>user</code>, <code>ip</code>, <code>tags</code> and <code>description</code> are optional, and <code>ts</code> defaults to the time dboss reads the line.</li>
          <li>One row per fingerprint per UTC minute holds the count, the first occurrence's message, and the distinct users and IPs (up to five each).</li>
          <li>Clicking a group opens its full dump and the last 50 minute rows. <strong>Resolve</strong>/<strong>Reopen</strong> flips <code>is_resolved</code> and audits the click; resolved rows dim.</li>
          <li><code>log_retention</code> prunes old minute rows; the summary, its flag and its first nonempty dump are kept.</li>
          <li>A malformed line becomes a <code>warn</code> row on the file's channel, like an event.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'blocked'}
      <section>
        <h2>Blocked requests</h2>
        <p>Every path a <code>deny</code> rule refuses is counted by path, once across every app and over time, in the reserved <code>_dboss</code> database. The <strong>Blocked requests</strong> page (<code>#/blocked</code>, reached from the Logs page) lists them biggest first.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Seeing what scanners and bots are probing the host: <code>/wp-login.php</code>, <code>*.php</code>, <code>/.env</code> and the rest.</li>
          <li>Checking a new deny rule is doing something, and how much it turns away.</li>
          <li>No request noise: a denied hit never reaches the app and is not a request row.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-blocked"><db-config-keys paths="deny" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.blocked" />
        <h3>Details</h3>
        <ul>
          <li><code>deny</code> refuses a request with <code>403</code> at the deny stage, before auth and before the app is contacted. A pattern is a suffix (<code>*.php</code>), a subtree (<code>/admin/*</code>) or an exact path (<code>/wp-login.php</code>), all case-insensitive.</li>
          <li>Each refused path is counted in the host's <code>blocked</code> table (<code>path</code>, <code>count</code>), aggregated across every app. The page shows the biggest 200 with each path's share of the total.</li>
          <li>The counters live with the audit rows in <code>_dboss</code> and are never pruned, so they outlive the per-app request retention.</li>
          <li>The page is host-wide, not per app: a path blocked on any host adds to the same count. It is read-only and writes no audit row.</li>
          <li>Common scanner targets are usually blocked for every app at once under <code>defaults.deny</code> in the host file; see <a href="#/help?topic=access">Access control</a> for the patterns and their place in the request pipeline.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'traffic'}
      <section>
        <h2>Traffic</h2>
        <p>The Traffic tab aggregates the request log of one app: requests over time, error rate, latency and the busiest paths, countries and clients. It reads the same store as the Logs tab, so there is nothing to set up.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Seeing at a glance whether an app is healthy: request volume, the share of 5xx answers and p50, p95 and p99 latency.</li>
          <li>Finding what to optimize: the slowest paths by average time, next to the most requested ones.</li>
          <li>Spotting a scraper or an attack: top client IPs, countries and methods for the last hour up to 30 days.</li>
          <li>Getting to the rows: a path, status code, IP or method opens the request log filtered to it.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-traffic"><db-config-keys paths="log_retention" /></div>
        <h3>Details</h3>
        <ul>
          <li>The ranges are the last hour, 24 hours, 7 days and 30 days. The chart shows one column per minute, hour or day, stacked by status class.</li>
          <li><code>log_retention</code> (default two weeks) bounds how far back the numbers go; with <code>log_retention: 0</code> the app has no request log and the tab stays empty.</li>
          <li>Latency quantiles are computed over the newest 50,000 requests of the range. Counts are exact.</li>
          <li>A path needs 5 requests in the range to show up under slowest paths, so one slow outlier does not top the list.</li>
          <li>Countries come from Cloudflare's <code>CF-IPCountry</code> header, and client IPs from <code>CF-Connecting-IP</code> behind <code>proxy.cloudflare</code>.</li>
          <li>Long-lived pubsub connections are not request rows, so they never skew the latency.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'events'}
      <section>
        <h2>Events</h2>
        <p>An app records analytics by appending one JSON object per line to <code>log/&#60;ns&#62;.json.log</code>. dboss reads those lines like any app log, stores them as Parquet per app, namespace and day, and answers counts, filters, funnels and SQL from the Events tab or <code>dboss events</code>. There is no SDK and no analytics service to run.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Counting what users do (signups, checkouts, feature use) without sending data to a third party.</li>
          <li>Slicing by tags, user, tenant, country or any key the app puts in <code>data</code>, with autocomplete for the values that exist.</li>
          <li>Funnels: how many users go from pricing to checkout to paid, within a window, broken down by plan.</li>
          <li>Reading the same files from the app itself: every process gets <code>DBOSS_EVENTS_DIR</code> and a ready <code>views.sql</code>.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-events"><db-config-keys paths="events.retention,events.views,events.funnels" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.eventsLine" lang="text" />
        <db-preview-yaml :text="state.examples.eventsFilter" lang="text" />
        <db-preview-yaml :text="state.examples.events" />
        <h3>Details</h3>
        <ul>
          <li><code>event</code> is required. <code>event</code>, <code>ts</code>, <code>user_id</code>, <code>anon_id</code>, <code>tenant_id</code>, <code>request_id</code> and <code>value</code> move out of <code>data</code> into their own columns; the rest of <code>data</code> stays JSON. <code>msg</code> is cut to 255 characters, <code>tags</code> holds labels and key:value pairs.</li>
          <li>A line without an event, or one that is not JSON, becomes a warning in the Logs tab on the file's channel. Every other <code>*.log</code> stays a plain log, so structured app logs must not use the <code>.json.log</code> suffix.</li>
          <li>dboss adds <code>country</code> from the request row of <code>request_id</code>. Files live under <code>dir/log/&#60;app&#62;/events</code>, one directory per namespace and UTC day, compacted each night at <code>maintenance_at</code>.</li>
          <li><code>events.retention</code> removes raw days; daily counts and tag facets stay, so the chart still covers older days. <code>0</code> stops ingesting.</li>
          <li>Views and funnels come from the app's <code>dboss.yaml</code> (read-only here) or are saved in this tab; a <code>dboss.yaml</code> entry wins over a console one with the same name.</li>
          <li>SQL and funnels run in the <code>duckdb</code> CLI 1.3 or newer, which must be on the service's PATH. Each run can read only the app's events directory, stops after 30 seconds and returns at most 500 rows. SQL runs are audited.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'cron'}
      <section>
        <h2>Scheduled jobs</h2>
        <p><code>cron:</code> declares one-shot commands dboss runs on a schedule, in the app folder with the app environment. They run even while the app is stopped.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Cleanup, report and sync tasks without a crontab on the box or a scheduler process in the app.</li>
          <li>Jobs that must not pile up: <code>overlap: false</code> skips a run while the last one is still going, and <code>timeout</code> kills a stuck one.</li>
          <li>Seeing what a job did: each one logs to its own <code>cron-&#60;job&#62;</code> channel, and the last run shows in the console and in <code>/metrics</code>.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-cron"><db-config-keys paths="cron" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.cron" />
        <h3>Details</h3>
        <p><code>schedule</code> is <code>every &#60;n&#62;&#60;s|m|h|d&#62;</code> or a five-field cron expression. <code>command</code> is a runtime shell line and is never <code>$NAME</code>-expanded at load.</p>
        <p><code>dboss cron shop</code> lists jobs and the next run; <code>dboss cron run shop cleanup</code> starts one now. The app card in the console has a Run button.</p>
      </section>
    {/if}

    {#if state.topic === 'hooks'}
      <section>
        <h2>Deploy hooks</h2>
        <p><code>hooks:</code> declares one-shot commands a signed HTTP ping triggers. The ping URL is <code>https://&#60;management.host&#62;/hooks/&#60;app&#62;/&#60;hook&#62;</code>.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Deploying from a Git host webhook (GitHub, GitLab) without giving it shell access.</li>
          <li>Rolling the app after the command succeeds: <code>restart: true</code> restarts (or starts) it after a clean exit.</li>
          <li>Running migrations or a console one-liner in the app's exact environment with <code>dboss exec</code>.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-hooks"><db-config-keys paths="hooks,tokens.dboss,management.host" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.hooks" />
        <h3>Details</h3>
        <p>Every ping presents <code>tokens.dboss</code> from the host file, a value you choose: <code>?token=</code> in the URL, <code>Authorization: Bearer</code>, <code>X-Gitlab-Token</code> (GitLab's Secret token field), or a GitHub <code>X-Hub-Signature-256</code> HMAC over the raw body (GitHub's Secret field). Without it every ping answers <code>401</code>. <code>dboss hooks</code> prints the ready-made URL; to change the token, edit it and run <code>dboss rescan</code>.</p>
        <p><code>dboss exec shop bundle exec rails runner ...</code> runs a one-off command in the same environment and prints its combined output; options like <code>--timeout</code> come before the command. Both hooks and cron write to their own log channel.</p>
      </section>
    {/if}

    {#if state.topic === 'lifecycle'}
      <section>
        <h2>Lifecycle</h2>
        <p><code>lifecycle:</code> names the commands dboss runs at three points of an app's life: <code>create</code> once before its first start, <code>start</code> before every start, and <code>destroy</code> when it is removed. The app sets up and cleans up what it owns, such as its database, and dboss only decides when.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Creating an app's database or seed data once, without a manual step on the box.</li>
          <li>Running migrations before the new processes take traffic, on every deploy restart and every wake.</li>
          <li>Dropping databases, logs or other stale data when a preview or a retired app is destroyed.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-lifecycle"><db-config-keys paths="lifecycle" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.lifecycle" />
        <h3>Details</h3>
        <ul>
          <li>Each step is a command or a <code>&#123;command, timeout&#125;</code> mapping; the timeout defaults to 3m. It runs in the app folder with the cron and hook environment (no <code>PORT</code>) and logs to the <code>lifecycle-&#60;step&#62;</code> channel.</li>
          <li><code>create</code> runs inside the first start, before <code>start</code>. The app is recorded in <code>dir/state/created.json</code> only when it exits 0, so a failure retries on the next start, and destroy clears the record. An app that already existed runs it once on its next start, so write it to be idempotent.</li>
          <li><code>start</code> runs on every start and restart, including a wake by the proxy. The app is <code>starting</code> meanwhile and its processes spawn only after a clean exit. A process restarted after a crash does not rerun it.</li>
          <li>A failed or timed-out <code>create</code> or <code>start</code> leaves the app <code>crashed</code> with the step's output in the error log and sends the <code>crash</code> event. Stopping the app kills a step still running.</li>
          <li><code>destroy</code> runs after <code>dboss destroy</code> has stopped and detached the app, before its folder is removed. It is cleanup: a failure is logged and sends <code>hook-failed</code>, and the destroy still completes.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'add'}
      <section>
        <h2>Add from git</h2>
        <p>A repository with its own <code>dboss.yaml</code> (or <code>config/dboss.yaml</code>) is a complete app. <strong>Add app</strong> on the overview, or <code>dboss add</code>, clones it into the apps folder, checks its config, loads it and starts it.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Installing an app on a new box with one URL: no ssh session, no manual clone and rescan.</li>
          <li>Keeping a repository's production domain off a staging box: a host given here replaces the app's own.</li>
          <li>Private GitHub repositories over https through <code>tokens.github</code>, which is never offered to another host.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-add"><db-config-keys paths="apps,tokens.github,procfile,hooks" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.add" lang="text" />
        <h3>Details</h3>
        <ul>
          <li>The URL may be <code>https://host/owner/repo</code>, <code>ssh://...</code>, <code>git@host:owner/repo</code> or the GitHub shorthand <code>owner/repo</code>. An ssh remote uses the service user's key; local paths and other schemes are refused.</li>
          <li>The name defaults to the repository name and must be a new folder under <code>apps</code>. An existing app is updated with a deploy, never by adding it again.</li>
          <li>A host is written into a <code>dboss.local.yaml</code> next to the app's file, a full copy with the single web process's <code>hosts</code> set and its <code>canonical_host</code> dropped. It needs exactly one web process.</li>
          <li>A host another app already serves is refused before the rescan, so a running app never loses its host.</li>
          <li>When anything fails after the clone the folder is removed again, and the reason stays in the dialog. The action is audited as <code>add</code> with the URL.</li>
          <li>Secrets are not in the repository: put <code>.env</code> or <code>dboss.local.yaml</code> in the app folder and restart when the first start needs them. With <code>hooks: &#123;deploy: true&#125;</code>, <code>dboss deploy git</code> updates the app afterwards.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'previews'}
      <section>
        <h2>GitHub PR previews</h2>
        <p>One built-in host hook, <code>github_pr</code>, turns a branch into a short-lived app. A Git host webhook pings <code>https://&#60;management.host&#62;/hooks/github_pr</code>; dboss checks out the branch, writes an app config from a <code>template</code> and starts it. The close action destroys it - no runner and no SSH deploy script.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>A live URL per pull request on the box that already runs the apps: every open PR gets its own app and hosts.</li>
          <li>Fitting many previews on one host: <code>autostart: false</code> keeps a preview down until its first request, so only the ones in use hold memory.</li>
          <li>Per-preview setup and cleanup through the template's <code>lifecycle</code> steps, such as a database created on the first deploy and dropped when the PR closes.</li>
          <li>Clean teardown, with no orphaned processes or checkouts left behind.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-previews"><db-config-keys paths="hooks,tokens.github,tokens.dboss,management.host" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.previews" />
        <p>The ping carries the branch and a few query params; a GitHub Action step sends them straight from the event:</p>
        <db-preview-yaml :text="state.examples.previewsPing" lang="text" />
        <h3>Details</h3>
        <ul>
          <li>The hook is host-level: <code>hooks.github_pr</code> in the root <code>dboss.yaml</code>, not under an app. One path segment is a host hook and two are an app hook, so its URL is <code>/hooks/github_pr</code>.</li>
          <li><code>action</code>, <code>branch</code>, <code>repo</code> and <code>num</code> become <code>QS_ACTION</code>, <code>QS_BRANCH</code>, <code>QS_REPO</code> and <code>QS_NUM</code> for the hook; <code>repo</code> falls back to the hook's own <code>repo</code>.</li>
          <li><code>action=closed</code> destroys the app, which runs its <code>destroy</code> step and removes the checkout; the template needs <code>deletable: true</code>. Any other action checks out the branch tip, writes the app from <code>template</code> and restarts it, which runs its <code>create</code> and <code>start</code> steps.</li>
          <li><code>template</code> is an app file with <code>$VAR</code> and <code>$&#123;VAR&#125;</code> interpolation. Its <code>name</code> is required and names the app folder; <code>main</code> and <code>development</code> are refused.</li>
          <li>A value in <code>hosts</code> or <code>canonical_host</code> is sanitized as a DNS label (<code>/</code> and <code>_</code> become <code>-</code>); everywhere else it is an identifier (<code>/</code> becomes <code>_</code>). A top-level <code>hosts</code> is the default for every procfile entry that declares none.</li>
          <li>A private <code>repo</code> over HTTPS is pulled with <code>tokens.github</code>; a fork PR works because the ping passes the head repo's clone URL. Pings for one branch run one at a time, while different branches deploy in parallel.</li>
          <li>Every step is audited under actor <code>hook:github_pr</code>. The preview is a normal app, so the console, <code>dboss ls</code>, the request log and <code>/metrics</code> all see it.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'pubsub'}
      <section>
        <h2>PubSub</h2>
        <p>A web process's <code>pubsub</code> option turns a URL prefix on its own hosts into a pub/sub hub. Use <code>pubsub: true</code> for <code>/socketio</code>, <code>pubsub: /path</code> for a custom prefix, or a mapping for the full settings. Each web process may run its own hub. It is served by dboss, not the app process, so subscribers connect while the app is stopped and realtime traffic never wakes it.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Live updates, notifications and chat without running a WebSocket server or Redis next to the app: the app publishes with one HTTP POST.</li>
          <li>Keeping long-lived sockets off the app's workers.</li>
          <li>Late joiners: the last <code>replay</code> messages are replayed to a subscriber that connects after they were sent.</li>
          <li>No frontend dependency: the bundled <code>&#60;path&#62;/client.js</code> picks WebSocket or SSE and reconnects.</li>
        </ul>
        <h3>Config keys</h3>
        <ul>
          <li><code>pubsub</code> - <code>true</code>, a path, or a mapping with <code>path</code>, <code>secret</code>, <code>replay</code>, <code>max_clients</code>, <code>max_message_size</code>, <code>client_events</code> and <code>test</code>. Only a web process may set it, and each web process runs its own hub.</li>
        </ul>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.pubsub" />
        <h3>Details</h3>
        <p><strong>Subscribe.</strong> A GET to <code>&#60;path&#62;/&#60;channel&#62;</code> upgrades to a WebSocket, or streams SSE when the request carries no <code>Upgrade</code> header. The bundled client at <code>&#60;path&#62;/client.js</code> picks the transport for you, reconnects and falls back to SSE:</p>
        <db-preview-yaml :text="state.examples.pubsubSubscribe" lang="text" />
        <p><strong>Publish.</strong> A POST to the same URL publishes with the app's secret. A body shaped like <code>&#123;"event","data"&#125;</code> is sent as written; any other body becomes the data of a <code>message</code> event.</p>
        <db-preview-yaml :text="state.examples.pubsubPublish" lang="text" />
        <p>Each message is <code>&#123;"event","data","ts"&#125;</code>; the last <code>replay</code> messages are replayed to a subscriber that joins late, oldest first. A slow subscriber is dropped rather than blocking the publisher. <code>client_events: true</code> lets a WebSocket client publish to its own channel with the same envelope.</p>
        <p>With no <code>secret</code> in the config, dboss generates one per web process under <code>dir/state</code>; the PubSub tab and <code>dboss pubsub</code> print it and <code>dboss pubsub rotate</code> replaces it. The self-test at <code>&#60;path&#62;/_test</code> (when <code>test: true</code>) opens a WebSocket and an SSE connection and reports PASS or FAIL.</p>
      </section>
    {/if}

    {#if state.topic === 'audit'}
      <section>
        <h2>Audit &amp; history</h2>
        <p>Every mutating action is recorded with its actor, and every config save keeps the previous file. Both work with no configuration.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Answering "who restarted this, and when": console actions carry the signed-in email, a hook ping carries <code>hook:&#60;app&#62;/&#60;hook&#62;</code>, control-socket actions are <code>cli</code>.</li>
          <li>Undoing a bad config edit: the last 50 revisions per file can be listed and restored.</li>
          <li>Keeping a change record for as long as your policy needs.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-audit"><db-config-keys paths="audit_retention,dir" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.audit" />
        <h3>Details</h3>
        <p>Audited actions: start, stop, restart, destroy, maintenance, rescan, cron and hook runs, <code>exec</code>, and config writes and restores, each with how it turned out.</p>
        <p>Rows live in the reserved <code>_dboss</code> database, are kept for <code>audit_retention</code> (default one year, <code>0</code> forever) and are pruned with the daily log prune. The Audit tab filters by app, actor and action; <code>dboss audit</code> prints the same rows.</p>
        <p>Every config save first copies the current file to <code>dir/state/config-history</code>, keeping the last 50 revisions per file. The Configuration view's History button lists them and can restore one, revision-checked; <code>dboss config history|restore</code> does the same from the CLI.</p>
      </section>
    {/if}

    {#if state.topic === 'health'}
      <section>
        <h2>Health &amp; metrics</h2>
        <p>The management host answers <code>/healthz</code>, <code>/readyz</code> and Prometheus <code>/metrics</code>, and every app answers a public health path on its own hosts.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Pointing an uptime monitor or a Cloudflare health check at an app without waking it and without credentials.</li>
          <li>Telling "the daemon is up" (<code>/healthz</code>) from "every app that should run is running" (<code>/readyz</code>).</li>
          <li>Dashboards and alert rules from per-app state, memory, CPU, restarts, request rates and latency quantiles.</li>
          <li>Checking a new box before the first start with <code>dboss doctor</code>.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-health"><db-config-keys paths="health_endpoint,tokens.dboss" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.health" />
        <h3>Details</h3>
        <p>The management host serves three endpoints:</p>
        <ul>
          <li><code>GET /healthz</code> - <code>200 ok</code> while the daemon is up.</li>
          <li><code>GET /readyz</code> - <code>200</code> only while every <code>autostart</code> app is running, else <code>503</code>.</li>
          <li><code>GET /metrics</code> - Prometheus text: per-app state, memory, CPU, restart and request rates, latency quantiles and the last cron and hook runs. It needs <code>tokens.dboss</code> as a bearer token and does not exist without one.</li>
        </ul>
        <p>Each app also answers on its own hosts at <code>health_endpoint</code> (default <code>/.well-known/dboss/health</code>): <code>200</code> while running and not draining, <code>503</code> otherwise. It runs before auth and never wakes a stopped app. <code>dboss doctor</code> preflights a box: tools, writable directories, a valid config and a clear port range.</p>
        <p>A web process's <code>health</code> path that gates readiness and restarts is under Supervision.</p>
      </section>
    {/if}

    {#if state.topic === 'notify'}
      <section>
        <h2>Notifications</h2>
        <p><code>notify:</code> posts runtime events to one operator webhook, debounced per app and event. Delivery is best-effort and queued, so it can never slow the supervisor down.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Hearing about a crash or a restart loop in chat before a user reports it.</li>
          <li>Knowing a deploy hook failed, a deploy went out or a backup did not run.</li>
          <li>Seeing config changes made from the console.</li>
          <li>No alert storm: one event for one app posts at most once every 5 minutes.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-notify"><db-config-keys paths="notify.url,notify.events,notify.headers" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.notify" />
        <h3>Details</h3>
        <p>Events: <code>crash</code>, <code>restart-loop</code>, <code>health-timeout</code>, <code>wake-failed</code>, <code>hook-failed</code>, <code>cron-failed</code>, <code>deploy</code>, <code>config-changed</code>, <code>backup-failed</code>, <code>error-rate</code>, <code>slow</code>, <code>oom</code> and <code>disk-low</code>. <code>error-rate</code> and <code>slow</code> come from the app's <code>alerts:</code> block: once a minute dboss checks the 5xx share and the p95 latency of the last 5 minutes of requests. An empty <code>url</code> disables it, and the payload follows the address: Slack, Discord and ntfy webhooks get their own shape, anything else the event as JSON. <code>wake-failed</code> comes only from a request-triggered start; explicit starts from the CLI or console do not notify. <code>oom</code> needs the cgroup backend, and <code>disk-low</code> fires when a filesystem dboss writes to passes <code>disk_alert</code> percent.</p>
      </section>
    {/if}

    {#if state.topic === 'alerts'}
      <section>
        <h2>Alerts</h2>
        <p><code>alerts:</code> watches the request log of every app and posts to the <code>notify</code> webhook when the app answers with too many errors or too slowly. Once a minute dboss looks at the last <code>window</code> of requests.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Hearing that an app serves 500s while its process is still up, which a crash alert never catches.</li>
          <li>Noticing a slow database or a stuck dependency from the p95 latency, before users complain.</li>
          <li>One policy for the whole box under <code>defaults:</code>, tuned per app where traffic differs.</li>
          <li>No false alarms on quiet apps: a check needs at least 20 requests in its 5 minute window.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-alerts"><db-config-keys paths="alerts.error_rate,alerts.slow_p95,disk_alert" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.alerts" />
        <h3>Details</h3>
        <ul>
          <li><code>error-rate</code> fires when the share of 5xx answers in the window reaches <code>error_rate</code> percent. The message reads <code>12.4% 5xx (31 of 250) in 5m</code>.</li>
          <li><code>slow</code> fires when the p95 latency reaches <code>slow_p95</code>. It is off by default, since a sane limit depends on the app.</li>
          <li>Both need <code>notify.url</code> and their name in <code>notify.events</code> (on by default). The 5 minute quiet period bounds the repeats; there is no recovery event, a quiet webhook means it stopped.</li>
          <li>An app with <code>log_retention: 0</code> has no request log and is never checked.</li>
          <li><code>disk-low</code> is the host-level check: once a minute every filesystem holding the config, the apps or the runtime folder is compared with <code>disk_alert</code> (default <code>90</code> percent, <code>0</code> off), and one event names each full one.</li>
          <li>The Traffic tab shows the same numbers for any range.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'postgres'}
      <section>
        <h2>PostgreSQL</h2>
        <p>dboss inspects the host's server read-only and dumps the databases you select on a daily run, as zips of a plain-SQL dump under <code>pg_backup/&lt;database&gt;/</code> next to the apps. The PostgreSQL tab appears only when a server is reachable.</p>
        <h3>What it helps with</h3>
        <ul>
          <li>Backups without a cron script: pick databases in the console, set their rotation, done.</li>
          <li>Bounded storage: one daily run, scheduled dumps kept for a week or a month, a manual backup kept until you remove it.</li>
          <li>Restoring, deleting or dropping a database from the console, and seeing sizes and connections at a glance.</li>
          <li>A SQL prompt without an SSH session: the <b>SQL</b> tab on a database runs statements against it from the browser.</li>
        </ul>
        <h3>Config keys</h3>
        <div fez:keep="keys-postgres"><db-config-keys paths="postgres.dsn,postgres.backups" /></div>
        <h3>Example</h3>
        <db-preview-yaml :text="state.examples.postgres" />
        <h3>Details</h3>
        <ul>
          <li>Connection: <code>postgres.dsn</code>, else the unix socket (<code>/var/run/postgresql</code>, then <code>/tmp</code>), else <code>127.0.0.1:5432</code>, with the libpq <code>PG*</code> environment merged in.</li>
          <li>Scheduled dumps run once a day at 04:00 local time. <code>backups</code> maps each selected database to its rotation: <code>week</code> keeps 7 days, <code>month</code> keeps 30. A manual backup from the tab is never rotated away.</li>
          <li>Each dump is a zip of a plain-SQL dump under <code>pg_backup/&lt;database&gt;/BACKUP_&lt;timestamp&gt;.zip</code>. The inspector itself writes nothing.</li>
          <li><b>Download</b> serves that zip as it is, and <b>Upload backup</b> stores one you picked as a manual entry, so a database moves between hosts: download here, upload there, restore there.</li>
          <li>A database page has a <b>Backup</b> and a <b>SQL</b> tab. SQL runs whatever you type as the role dboss connects with, <code>Cmd/Ctrl+Enter</code> runs it, a pasted batch runs in order and shows the last result set, and 500 rows travel while the full count is still reported. A run is bounded by a 30 second <code>statement_timeout</code>, and because it can write, every run is audited as <code>pg-query</code> with the statement.</li>
          <li><code>postgres</code> is a host key but applies without a daemon restart. The console writes the selection to the server-only <code>dboss.local.yaml</code>.</li>
          <li>The box needs <code>pg_dump</code> and <code>psql</code> on the service user's <code>PATH</code>, and a role that can read every selected database.</li>
        </ul>
      </section>
    {/if}

    {#if state.topic === 'cli'}
      <section>
        <h2>CLI</h2>
        <p>Remote commands talk to the running host over its control socket and accept <code>--json</code>. Inside an app folder the app argument defaults to that app. Run <code>dboss help &#60;command&#62;</code> for one command.</p>
        <h3>Host session</h3>
        <div class="help-cmd"><code>start</code><span>run the host in the foreground; Ctrl-C stops every app</span></div>
        <div class="help-cmd"><code>systemd</code><span>print the systemd unit, or install and enable it</span></div>
        <div class="help-cmd"><code>kill</code><span>stop every app and clear every listener in ports</span></div>
        <div class="help-cmd"><code>login</code><span>print a one-time console URL that signs you in as cli@localhost</span></div>
        <h3>Apps</h3>
        <div class="help-cmd"><code>add</code><span>clone a repository with a <code>dboss.yaml</code> into the apps folder and start it</span></div>
        <div class="help-cmd"><code>ls</code><span>list apps with state, ports, uptime, activity and memory</span></div>
        <div class="help-cmd"><code>run</code><span>start an app, rescanning first when it is not known yet</span></div>
        <div class="help-cmd"><code>stop</code><span>stop an app and keep it stopped until run or the next request</span></div>
        <div class="help-cmd"><code>restart</code><span>stop and start an app on the same ports</span></div>
        <div class="help-cmd"><code>destroy</code><span>stop and permanently remove an app with <code>deletable: true</code></span></div>
        <div class="help-cmd"><code>status</code><span>processes, restarts, resources and request rates for one app</span></div>
        <div class="help-cmd"><code>logs</code><span>print or follow the process logs; <code>-f</code> follows</span></div>
        <div class="help-cmd"><code>maintenance</code><span>serve the maintenance page while the app keeps running</span></div>
        <div class="help-cmd"><code>cron</code><span>list an app's scheduled jobs, or run one now</span></div>
        <div class="help-cmd"><code>hooks</code><span>list an app's deploy hooks with their ping URL, or run one</span></div>
        <div class="help-cmd"><code>exec</code><span>run a one-off command in the app's environment</span></div>
        <div class="help-cmd"><code>audit</code><span>list operator actions: start, stop, restart, destroy, hook runs and config writes</span></div>
        <h3>Config</h3>
        <div class="help-cmd"><code>config</code><span>validate and print a config, the resolved config, keys, or saved revisions</span></div>
        <div class="help-cmd"><code>check</code><span>validate the config and every app without starting anything</span></div>
        <div class="help-cmd"><code>pages</code><span>list which file renders each dboss page, or write the built-in ones out to edit</span></div>
        <div class="help-cmd"><code>doctor</code><span>preflight a box: tools, writable directories, valid config, clear ports</span></div>
        <div class="help-cmd"><code>rescan</code><span>re-read the apps directory and every dboss.yaml</span></div>
        <div class="help-cmd"><code>ports</code><span>show the live port table, one fixed port per process</span></div>
        <div class="help-cmd"><code>password</code><span>print a bcrypt hash for basic_auth</span></div>
      </section>
    {/if}

    {#if state.topic === 'keys'}
      <section class="help-keys">
        <h2>Keys</h2>
        <p>Every key, its type, its default (or an example) and where it applies. Use the filter to narrow by name or description; the annotated reference has the long form.</p>
        <db-config-keys />
      </section>
    {/if}
  </div>
</div>
