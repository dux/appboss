<script>
  class {
    init() {
      this.state.snapshot = null
      this.state.backups = []
      this.state.rotations = {}
      this.state.db = Pjax.hqs('db') || ''
      this.state.selected = null
      this.state.loading = false
      this.state.busy = false
      this.state.error = ''
      this.state.message = ''
      this.state.messageError = false
      this.state.filter = ''
      this.state.tab = Dboss.readQs('tab') === 'sql' ? 'sql' : 'backup'
      this.state.selectTab = (tab) => this.setTab(tab)
      this.state.result = null
      this.state.resultError = ''
      this.state.running = false
    }

    onMount() {
      this.load()
    }

    // The rotation select is a fez:this ref: its value must be written after each render, since a
    // selected attribute alone does not move the live selection once the user has changed it.
    afterRender() {
      const node = this.state.rotationNode
      if (!node || node === document.activeElement) return
      const value = this.state.selected ? (this.state.rotations[this.state.selected.name] || 'week') : 'week'
      if (node.value !== value) node.value = value
    }

    resolveSelected() {
      const rows = (this.state.snapshot && this.state.snapshot.databases) || []
      this.state.selected = rows.find((row) => row.name === this.state.db) || null
    }

    async load(refresh = false) {
      this.state.loading = true
      try {
        const data = refresh
          ? await Dboss.api('/api/pg/refresh', { method: 'POST', body: '{}' })
          : await Dboss.api('/api/pg')
        this.apply(data)
        this.state.error = ''
      } catch (error) {
        this.state.error = error.message
      } finally {
        this.state.loading = false
      }
    }

    apply(data) {
      const snapshot = data.snapshot
      if (snapshot) {
        snapshot.server = snapshot.server || {}
        snapshot.server.replicas = snapshot.server.replicas || []
        snapshot.activity = snapshot.activity || {}
        snapshot.databases = snapshot.databases || []
        snapshot.tablespaces = snapshot.tablespaces || []
      }
      this.state.snapshot = snapshot
      this.state.backups = data.backups || []
      const configured = data.rotation || {}
      const rotations = {}
      for (const row of (snapshot && snapshot.databases) || []) {
        if (Object.prototype.hasOwnProperty.call(configured, row.name)) {
          rotations[row.name] = configured[row.name] === 'month' ? 'month' : 'week'
        } else {
          rotations[row.name] = 'off'
        }
      }
      this.state.rotations = rotations
      this.resolveSelected()
    }

    setFilter(value) {
      this.state.filter = value
    }

    databases() {
      const rows = (this.state.snapshot && this.state.snapshot.databases) || []
      const filter = this.state.filter.trim().toLowerCase()
      if (!filter) return rows
      return rows.filter((row) => row.name.toLowerCase().includes(filter))
    }

    openDatabase(name) {
      this.state.db = name
      this.resolveSelected()
      this.state.message = ''
      this.state.messageError = false
      this.clearResult()
      Pjax.hqs('db', name)
    }

    closeDatabase() {
      this.state.db = ''
      this.state.selected = null
      this.clearResult()
      Dboss.setQs('tab', '')
      Pjax.hqs('db', null)
    }

    setTab(tab) {
      this.state.tab = tab
      Dboss.setQs('tab', tab === 'backup' ? '' : tab)
    }

    rotationLabel(name) {
      const rotation = this.state.rotations[name]
      if (rotation === 'month') return 'Month'
      if (rotation === 'off') return 'Off'
      return 'Week'
    }

    lastBackup(name) {
      return this.state.backups.find((entry) => entry.database === name && entry.status === 'ok') || null
    }

    backupsFor(name) {
      return this.state.backups.filter((entry) => entry.database === name)
    }

    async setRotation(name, value) {
      this.state.rotations = { ...this.state.rotations, [name]: value }
      await this.save()
    }

    async save() {
      if (this.state.busy) return
      const backups = {}
      for (const [name, rotation] of Object.entries(this.state.rotations)) {
        if (rotation === 'off') continue
        backups[name] = rotation
      }
      try {
        this.state.busy = true
        const data = await Dboss.api('/api/pg/config', { method: 'POST', body: JSON.stringify({ backups }) })
        this.apply(data)
        this.message('Backup rotation saved.')
        Toast.show('PostgreSQL backup rotation saved')
      } catch (error) {
        this.message(error.message, true)
        Toast.show(error.message, true)
      } finally {
        this.state.busy = false
      }
    }

    async backupNow(name = '') {
      if (this.state.busy) return
      try {
        this.state.busy = true
        const data = await Dboss.api('/api/pg/backup', { method: 'POST', body: JSON.stringify({ database: name }) })
        this.state.backups = data.backups || []
        this.message(name ? `Backup finished for ${name}.` : 'Backup finished.')
        Toast.show(name ? `${name}: backup finished` : 'Backup finished')
      } catch (error) {
        this.message(error.message, true)
        Toast.show(error.message, true)
      } finally {
        this.state.busy = false
      }
    }

    // uploadBackup sends the picked archive as it is; the server stores the bytes and records a
    // manual entry, so an archive from another host restores through the normal path.
    async uploadBackup() {
      const node = this.state.uploadNode
      const file = node && node.files && node.files[0]
      const name = this.state.selected && this.state.selected.name
      if (!file || !name || this.state.busy) return
      const body = new FormData()
      body.append('file', file)
      try {
        this.state.busy = true
        const data = await Dboss.api(`/api/pg/backup/upload?database=${encodeURIComponent(name)}`, { method: 'POST', body })
        this.state.backups = data.backups || []
        this.message(`Uploaded ${file.name} into ${name}.`)
        Toast.show(`${name}: backup uploaded`)
      } catch (error) {
        this.message(error.message, true)
        Toast.show(error.message, true)
      } finally {
        if (node) node.value = ''
        this.state.busy = false
      }
    }

    async restoreById(id) {
      const entry = this.state.backups.find((candidate) => candidate.id === id)
      if (!entry || this.state.busy) return
      const target = window.prompt(`Restore ${entry.database} into which database?`, `${entry.database}_restore`)
      if (!target) return
      if (!window.confirm(`Restore backup ${entry.id} into ${target}?`)) return
      try {
        this.state.busy = true
        const result = await Dboss.api('/api/pg/restore', { method: 'POST', body: JSON.stringify({ id: entry.id, target }) })
        Toast.show(`Restored into ${result.target}`)
        this.message(`Restored into ${result.target}.`)
      } catch (error) {
        this.message(error.message, true)
        Toast.show(error.message, true)
      } finally {
        this.state.busy = false
      }
    }

    async deleteBackup(id) {
      if (this.state.busy) return
      if (!window.confirm(`Delete backup ${id}?`)) return
      try {
        this.state.busy = true
        const data = await Dboss.api('/api/pg/backup/delete', { method: 'POST', body: JSON.stringify({ id }) })
        this.state.backups = data.backups || []
        Toast.show('Backup deleted')
        this.message('Backup deleted.')
      } catch (error) {
        this.message(error.message, true)
        Toast.show(error.message, true)
      } finally {
        this.state.busy = false
      }
    }

    async dropDatabase(name) {
      if (this.state.busy) return
      const typed = window.prompt(`This permanently drops ${name}. Type the database name to confirm.`)
      if (typed === null) return
      if (typed !== name) {
        this.message('Database name did not match; nothing was dropped.', true)
        Toast.show('Database name did not match', true)
        return
      }
      try {
        this.state.busy = true
        await Dboss.api('/api/pg/drop', { method: 'POST', body: JSON.stringify({ database: name, confirm: name }) })
        this.closeDatabase()
        Toast.show(`${name} dropped`)
        await this.load(true)
        this.message(`${name} dropped.`)
      } catch (error) {
        this.message(error.message, true)
        Toast.show(error.message, true)
      } finally {
        this.state.busy = false
      }
    }

    // The editor is a fez:keep textarea, so the statement is read off the node rather than held
    // in a rendered state key: a result render must never touch what the operator typed.
    async runSQL() {
      const node = this.state.sqlNode
      const name = this.state.selected && this.state.selected.name
      const sql = node ? node.value.trim() : ''
      if (!name || !sql || this.state.running) return
      this.state.running = true
      this.state.resultError = ''
      try {
        const data = await Dboss.api('/api/pg/query', { method: 'POST', body: JSON.stringify({ database: name, sql }) })
        this.state.result = data.result
      } catch (error) {
        this.state.result = null
        this.state.resultError = error.message
        Toast.show(error.message, true)
      } finally {
        this.state.running = false
      }
    }

    sqlKeydown(event) {
      if (event.key !== 'Enter' || !(event.metaKey || event.ctrlKey)) return
      event.preventDefault()
      this.runSQL()
    }

    clearResult() {
      this.state.result = null
      this.state.resultError = ''
    }

    cell(value) {
      return value === null || value === undefined ? 'NULL' : value
    }

    message(text, error = false) {
      this.state.message = text
      this.state.messageError = error
    }

    stamp(value) {
      if (!value) return '-'
      const date = new Date(value)
      if (isNaN(date.getTime())) return value
      return date.toLocaleString()
    }

    ago(value) {
      if (!value) return ''
      const then = new Date(value).getTime()
      if (isNaN(then)) return ''
      const seconds = Math.max(0, Math.floor((Date.now() - then) / 1000))
      if (seconds < 60) return `${seconds}s ago`
      const minutes = Math.floor(seconds / 60)
      if (minutes < 60) return `${minutes}m ago`
      const hours = Math.floor(minutes / 60)
      if (hours < 24) return `${hours}h ago`
      const days = Math.floor(hours / 24)
      if (days < 30) return `${days}d ago`
      const months = Math.floor(days / 30)
      if (months < 12) return `${months}mo ago`
      return `${Math.floor(months / 12)}y ago`
    }

    bytes(value) {
      const amount = Number(value || 0)
      if (!amount) return '-'
      const units = ['B', 'KB', 'MB', 'GB', 'TB']
      let index = 0
      let size = amount
      while (size >= 1024 && index < units.length - 1) {
        size /= 1024
        index++
      }
      return `${size.toFixed(index === 0 ? 0 : 1)} ${units[index]}`
    }

    number(value) {
      return new Intl.NumberFormat().format(Number(value || 0))
    }

    duration(seconds) {
      const total = Number(seconds || 0)
      if (!total) return '-'
      const days = Math.floor(total / 86400)
      const hours = Math.floor((total % 86400) / 3600)
      const minutes = Math.floor((total % 3600) / 60)
      if (days) return `${days}d ${hours}h`
      if (hours) return `${hours}h ${minutes}m`
      return `${minutes}m`
    }

    percent(value) {
      return `${Math.round(Number(value || 0) * 1000) / 10}%`
    }

    seconds(value) {
      return (Number(value || 0)).toFixed(1)
    }
  }
</script>

{#if state.selected}
  <div class="page-header">
    <div>
      <p class="page-pretitle"><a href="#/pg">&larr; Databases</a></p>
      <h1 class="page-title">{state.selected.name}</h1>
    </div>
    <div class="page-actions">
      <button class="btn" type="button" onclick="fez.load(true)" disabled={state.loading}>
        <svg class="icon"><use href="#i-refresh"></use></svg>
        {state.loading ? 'Inspecting' : 'Re-inspect'}
      </button>
      <button class="btn btn-primary" type="button" onclick="fez.backupNow('{state.selected.name}')" disabled={state.busy}>
        <svg class="icon"><use href="#i-save"></use></svg>
        Back up now
      </button>
      <button class="btn btn-danger" type="button" onclick="fez.dropDatabase('{state.selected.name}')" disabled={state.busy}>Drop database</button>
    </div>
  </div>
{:else}
  <div class="page-header">
    <div>
      <p class="page-pretitle">PG SQL</p>
      <h1 class="page-title">{state.snapshot && state.snapshot.available ? state.snapshot.server.version : 'Server &amp; backups'}</h1>
    </div>
    <div class="page-actions">
      {#if state.snapshot}
        <span class="refresh-status">Collected {stamp(state.snapshot.collected_at)}</span>
      {/if}
      <button class="btn" type="button" onclick="fez.load(true)" disabled={state.loading}>
        <svg class="icon"><use href="#i-refresh"></use></svg>
        {state.loading ? 'Inspecting' : 'Re-inspect'}
      </button>
      <button class="btn btn-primary" type="button" onclick="fez.backupNow()" disabled={state.busy}>
        <svg class="icon"><use href="#i-save"></use></svg>
        Back up all
      </button>
    </div>
  </div>
{/if}

{#if state.error}
  <div class="alert alert-danger">{state.error}</div>
{/if}

{#if !state.snapshot}
  <div class="card empty-state">
    <span class="spinner" aria-hidden="true"></span>
    <strong>Reading PostgreSQL facts</strong>
    <span>Connecting to the local server and listing its databases.</span>
  </div>
{:else if state.selected}
  <ui-tabs tabs="backup:Backup,sql:SQL" active={state.tab} :onselect="state.selectTab" />
{#if state.tab === 'sql'}
  <div class="section-head">
    <h2>SQL</h2>
    <span class="text-muted">Runs on {state.selected.name} as the role dboss connects with</span>
  </div>
  <section class="card sql-runner">
    <div fez:keep="sql-editor">
      <textarea class="sql-editor" spellcheck="false" placeholder="select * from users order by created_at desc limit 20" fez:this="sqlNode" onkeydown="fez.sqlKeydown(event)"></textarea>
    </div>
    <div class="sql-actions">
      <button class="btn btn-primary" type="button" onclick="fez.runSQL()" disabled={state.running}>
        <svg class="icon"><use href="#i-play"></use></svg>
        {state.running ? 'Running' : 'Run'}
      </button>
      <span class="text-muted">{state.running ? 'Waiting for the server' : 'Cmd/Ctrl+Enter runs. Several statements run in order; the last result set is shown. Every run is audited.'}</span>
    </div>
  </section>

  {#if state.resultError}
    <div class="alert alert-danger sql-error">{state.resultError}</div>
  {/if}

  {#if state.result}
    <div class="section-head">
      <h2>Result</h2>
      <span class="text-muted">{state.result.command || '-'} · {number(state.result.row_count)} rows · {number(state.result.duration_ms)} ms</span>
    </div>
    <section class="card">
      {#if state.result.columns}
        <div class="sql-result">
          <table class="sql-table">
            <thead>
              <tr>
                {#each state.result.columns as column}
                  <th>{column}</th>
                {/each}
              </tr>
            </thead>
            <tbody>
              {#each state.result.rows as row}
                <tr>
                  {#each row as value}
                    <td class:sql-null={value === null}>{cell(value)}</td>
                  {/each}
                </tr>
              {/each}
            </tbody>
          </table>
        </div>
        {#if state.result.truncated}
          <p class="text-muted sql-note">Showing the first {number(state.result.rows.length)} of {number(state.result.row_count)} rows. Add a LIMIT to see the rest.</p>
        {/if}
      {:else}
        <p class="text-muted sql-note">{state.result.command || 'Done'} · {number(state.result.row_count)} rows affected. The statement returned no result set.</p>
      {/if}
    </section>
  {/if}
{:else}
  <div class="section-head">
    <h2>Overview</h2>
  </div>
  <section class="card">
    <div class="datagrid pg-detail-stats">
      <div class="datagrid-item"><span class="subheader">Owner</span><span class="datagrid-content">{state.selected.owner || '-'}</span></div>
      <div class="datagrid-item"><span class="subheader">Size</span><span class="datagrid-content">{bytes(state.selected.size_bytes)}</span></div>
      <div class="datagrid-item"><span class="subheader">Encoding</span><span class="datagrid-content">{state.selected.encoding || '-'}</span></div>
      <div class="datagrid-item"><span class="subheader">Collate</span><span class="datagrid-content">{state.selected.collate || '-'}</span></div>
      <div class="datagrid-item"><span class="subheader">Connections</span><span class="datagrid-content">{state.selected.connections}</span></div>
      <div class="datagrid-item"><span class="subheader">Commits</span><span class="datagrid-content">{number(state.selected.xact_commit)}</span></div>
      <div class="datagrid-item"><span class="subheader">Rollbacks</span><span class="datagrid-content">{number(state.selected.xact_rollback)}</span></div>
      <div class="datagrid-item"><span class="subheader">Deadlocks</span><span class="datagrid-content">{number(state.selected.deadlocks)}</span></div>
      <div class="datagrid-item"><span class="subheader">Temp bytes</span><span class="datagrid-content">{bytes(state.selected.temp_bytes)}</span></div>
    </div>
  </section>

  <div class="section-head">
    <h2>Backup rotation</h2>
  </div>
  <section class="card">
    <div class="pg-detail-actions">
      <label class="pg-check">
        Rotation
        <select fez:this="rotationNode" onchange="fez.setRotation('{state.selected.name}', this.value)" disabled={state.busy}>
          <option value="week" selected={state.rotations[state.selected.name] === 'week'}>Week</option>
          <option value="month" selected={state.rotations[state.selected.name] === 'month'}>Month</option>
          <option value="off" selected={state.rotations[state.selected.name] === 'off'}>Off</option>
        </select>
      </label>
      <span class="text-muted">Scheduled dumps run daily; week keeps 7 days, month keeps 30. A manual backup is never rotated away.</span>
    </div>
    {#if state.message}
      <div class="config-message" class:error={state.messageError} role="status">{state.message}</div>
    {/if}
  </section>

  <div class="section-head">
    <h2>Backups</h2>
    <span class="text-muted">{backupsFor(state.selected.name).length} recorded</span>
  </div>
  <section class="card">
    <div class="pg-detail-actions pg-backup-upload">
      <label class="btn" disabled={state.busy}>
        <svg class="icon"><use href="#i-upload"></use></svg>
        Upload backup
        <input type="file" accept=".zip,application/zip" hidden fez:this="uploadNode" onchange="fez.uploadBackup()" disabled={state.busy}>
      </label>
      <span class="text-muted">A dboss backup zip is stored as it is and kept until you remove it.</span>
    </div>
    <div class="pg-backups">
      {#each backupsFor(state.selected.name) as entry}
        <div class="pg-backup-line">
          <span class="pg-backup-when">{stamp(entry.time)}</span>
          <span class="text-muted">{ago(entry.time) || '-'}</span>
          <span class="text-muted">·</span>
          <span class="service-value">{bytes(entry.bytes)}</span>
          {#if entry.manual}
            <span class="badge">manual</span>
          {/if}
          <span class="badge" class:badge-success={entry.status === 'ok'} class:badge-danger={entry.status !== 'ok'}>{entry.status}</span>
          <span class="pg-backup-action">
            {#if entry.status === 'ok'}
              <a class="btn btn-sm" href="/api/pg/backup/download?id={entry.id}" download>Download</a>
              <button class="btn btn-sm" type="button" onclick="fez.restoreById('{entry.id}')" disabled={state.busy}>Restore</button>
            {:else}
              <span class="text-muted">{entry.error || '-'}</span>
            {/if}
            <button class="btn btn-sm" type="button" onclick="fez.deleteBackup('{entry.id}')" disabled={state.busy}>Delete</button>
          </span>
        </div>
      {:else}
        <div class="pg-backup-line text-muted">No backups for this database yet.</div>
      {/each}
    </div>
  </section>
{/if}
{:else}
  <section class="stat-row" aria-label="PostgreSQL summary">
    <article class="card stat-card">
      <span class="subheader">Version</span>
      <strong class="stat-value">{state.snapshot.server.version_num || '-'}</strong>
      <span class="text-muted">{state.snapshot.server.description || '-'}</span>
    </article>
    <article class="card stat-card">
      <span class="subheader">Uptime</span>
      <strong class="stat-value">{duration(state.snapshot.server.uptime_seconds)}</strong>
      <span class="text-muted">since {stamp(state.snapshot.server.started_at)}</span>
    </article>
    <article class="card stat-card">
      <span class="subheader">Connections</span>
      <strong class="stat-value">{state.snapshot.server.current_connections}</strong>
      <span class="text-muted">of {state.snapshot.server.max_connections} allowed</span>
    </article>
    <article class="card stat-card">
      <span class="subheader">Cache hit</span>
      <strong class="stat-value">{percent(state.snapshot.server.cache_hit_ratio)}</strong>
      <span class="text-muted">{state.snapshot.server.in_recovery ? 'standby' : 'primary'} · {number((state.snapshot.databases || []).length)} databases</span>
    </article>
  </section>

  <div class="section-head">
    <h2>Activity</h2>
  </div>
  <section class="card">
    <div class="datagrid">
      <div class="datagrid-item"><span class="subheader">Active</span><span class="datagrid-content">{state.snapshot.activity.active}</span></div>
      <div class="datagrid-item"><span class="subheader">Idle</span><span class="datagrid-content">{state.snapshot.activity.idle}</span></div>
      <div class="datagrid-item"><span class="subheader">Idle in transaction</span><span class="datagrid-content">{state.snapshot.activity.idle_in_transaction}</span></div>
      <div class="datagrid-item"><span class="subheader">Waiting on lock</span><span class="datagrid-content">{state.snapshot.activity.blocked}</span></div>
      <div class="datagrid-item"><span class="subheader">Longest query</span><span class="datagrid-content">{seconds(state.snapshot.activity.longest_seconds)}s</span></div>
      <div class="datagrid-item"><span class="subheader">WAL LSN</span><span class="datagrid-content">{state.snapshot.server.wal_lsn || '-'}</span></div>
    </div>
  </section>

  {#if state.snapshot.server.replicas.length}
    <div class="section-head">
      <h2>Replication</h2>
    </div>
    <section class="card">
      <div class="sys-tools">
        <div class="sys-row sys-head pg-replica-row">
          <span class="subheader">Client</span>
          <span class="subheader">State</span>
          <span class="subheader">Sync</span>
          <span class="subheader">Lag</span>
        </div>
        {#each state.snapshot.server.replicas as replica}
          <div class="sys-row pg-replica-row">
            <span class="service-name">{replica.client_addr}</span>
            <span class="sys-version">{replica.state}</span>
            <span class="sys-version">{replica.sync_state}</span>
            <span class="service-value">{bytes(replica.lag_bytes)}</span>
          </div>
        {/each}
      </div>
    </section>
  {/if}

  {#if state.snapshot.tablespaces.length}
    <div class="section-head">
      <h2>Tablespaces</h2>
    </div>
    <section class="card">
      <div class="sys-tools">
        <div class="sys-row sys-head pg-tablespace-row">
          <span class="subheader">Name</span>
          <span class="subheader">Location</span>
          <span class="subheader">Size</span>
        </div>
        {#each state.snapshot.tablespaces as tablespace}
          <div class="sys-row pg-tablespace-row">
            <span class="service-name">{tablespace.name}</span>
            <span class="sys-version">{tablespace.location || '-'}</span>
            <span class="service-value">{bytes(tablespace.size_bytes)}</span>
          </div>
        {/each}
      </div>
    </section>
  {/if}

  <div class="section-head">
    <h2>Databases</h2>
    <span class="text-muted">Select a database for options and backups</span>
  </div>
  <section class="card">
    <div class="card-header">
      <h3 class="section-title">All databases</h3>
      <div class="card-actions">
        <input type="text" placeholder="Filter" value={state.filter} oninput="fez.setFilter(this.value)" />
      </div>
    </div>
    <div class="sys-tools pg-databases">
      <div class="sys-row sys-head pg-row">
        <span class="subheader">Database</span>
        <span class="subheader">Size</span>
        <span class="subheader">Owner</span>
        <span class="subheader">Conns</span>
        <span class="subheader">Last backup</span>
        <span class="subheader">Rotation</span>
      </div>
      {#each databases() as database}
        <div class="sys-row pg-row pg-row-click" class:pg-row-active={state.selected && state.selected.name === database.name} onclick="fez.openDatabase('{database.name}')">
          <span class="service-name">{database.name}</span>
          <span class="service-value">{bytes(database.size_bytes)}</span>
          <span class="sys-version">{database.owner}</span>
          <span class="service-value">{database.connections}</span>
          <span class="sys-version">
            {#if lastBackup(database.name)}
              {stamp(lastBackup(database.name).time)} · {ago(lastBackup(database.name).time)}
            {:else}
              <span class="text-muted">never</span>
            {/if}
          </span>
          <span class="sys-version">{rotationLabel(database.name)}</span>
        </div>
      {:else}
        <div class="sys-row sys-empty text-muted">No database matches the filter.</div>
      {/each}
    </div>
  </section>
{/if}
