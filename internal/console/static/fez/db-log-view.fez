<script>
  class {
    PROPS = {
      app: { type: String, default: '' },
      channel: { type: String, default: '' },
      page: Boolean,
    }

    init(props) {
      this.state.page = Boolean(props.page)
      this.state.app = props.app || ''
      this.state.channel = props.channel || ''
      this.state.range = '1h'
      this.state.level = ''
      this.state.method = ''
      this.state.status = ''
      this.state.query = ''
      this.state.tree = []
      this.state.rows = []
      this.state.kind = 'log'
      this.state.loaded = false
      this.state.busy = false
      this.state.error = ''
      this.state.before = ''
      this.state.expandedKey = ''
      this.state.queryNode = null
      this.state.queryTimer = 0
      if (this.state.page) {
        this.state.app = Fez.hqs('app') || this.state.app
        this.state.channel = Fez.hqs('channel') || this.state.channel
        this.state.range = Fez.hqs('range') || this.state.range
        this.state.level = Fez.hqs('level') || ''
        this.state.method = Fez.hqs('method') || ''
        this.state.status = Fez.hqs('status') || ''
        this.state.query = Fez.hqs('q') || ''
      }
    }

    onMount() {
      this.on('keydown', (event) => this.shortcut(event))
      this.ready()
    }

    onDestroy() {
      clearTimeout(this.state.queryTimer)
    }

    // The search input is a fez:keep-style field: typing must not fight a re-render.
    afterRender() {
      this.syncValue(this.state.rangeNode, this.state.range)
      this.syncValue(this.state.levelNode, this.state.level)
      this.syncValue(this.state.methodNode, this.state.method)
      this.syncValue(this.state.statusNode, this.state.status)
      this.syncValue(this.state.queryNode, this.state.query)
    }

    syncValue(node, value) {
      if (node && node !== document.activeElement && node.value !== value) node.value = value
    }

    async ready() {
      await this.reload()
    }

    async reload() {
      await this.loadTree()
      await this.load()
    }

    async loadTree() {
      try {
        const data = await Dboss.api('/api/log/tree')
        this.state.tree = data.apps || []
        const names = this.state.tree.map((group) => group.name)
        if (!names.includes(this.state.app)) this.state.app = names[0] || ''
        const group = this.state.tree.find((entry) => entry.name === this.state.app)
        const ids = (group?.channels || []).map((channel) => channel.id)
        if (!ids.includes(this.state.channel)) this.state.channel = ids[0] || ''
        this.state.error = ''
      } catch (error) {
        this.state.error = error.message
      }
    }

    bytes(value) {
      let amount = Number(value || 0)
      if (amount < 1024) return `${amount} B`
      const units = ['KB', 'MB', 'GB', 'TB']
      let unit = units[0]
      amount /= 1024
      for (let index = 1; amount >= 1024 && index < units.length; index += 1) {
        amount /= 1024
        unit = units[index]
      }
      return `${amount >= 10 ? amount.toFixed(0) : amount.toFixed(1)} ${unit}`
    }

    appLabel(name) {
      return name === '_dboss' ? 'Host (dboss)' : name
    }

    // serviceLabel adds the fixed port to a service channel, so two processes with different
    // outputs are told apart by more than their name.
    serviceLabel(channel, appName) {
      const id = channel.id
      const request = id.startsWith('request:')
      const stdout = id.startsWith('stdout:')
      if (!request && !stdout) return channel.label
      const processName = id.slice(request ? 8 : 7)
      const app = (this.globalState.apps || []).find((entry) => entry.name === appName)
      const process = (app?.processes || []).find((entry) => entry.name === processName)
      const label = request ? `${processName} requests` : processName
      return process?.port ? `${label} :${process.port}` : label
    }

    isRequest() {
      return this.state.channel === 'request' || this.state.channel.startsWith('request:')
    }

    pickService(appIndex, channelIndex) {
      const group = this.state.tree[appIndex]
      const channel = group?.channels?.[channelIndex]
      if (!group || !channel) return
      if (this.state.app === group.name && this.state.channel === channel.id) return
      this.state.app = group.name
      this.state.channel = channel.id
      this.resetFilters()
      this.load()
    }

    resetFilters() {
      this.state.level = ''
      this.state.method = ''
      this.state.status = ''
      this.state.expandedKey = ''
    }

    rangeMs() {
      const ranges = { '5m': 300000, '15m': 900000, '1h': 3600000, '6h': 21600000, '24h': 86400000, '7d': 604800000 }
      return ranges[this.state.range] || 0
    }

    since() {
      const ms = this.rangeMs()
      return ms ? new Date(Date.now() - ms).toISOString() : ''
    }

    async load({ append = false } = {}) {
      if (!this.state.app) return
      this.state.busy = true
      try {
        const params = new URLSearchParams({ app: this.state.app, channel: this.state.channel, limit: '300' })
        const since = this.since()
        if (since) params.set('since', since)
        if (this.state.query) params.set('q', this.state.query)
        if (this.state.level) params.set('level', this.state.level)
        if (this.state.method) params.set('method', this.state.method)
        if (this.state.status) params.set('status', this.state.status)
        if (append && this.state.before) params.set('before', this.state.before)
        const data = await Dboss.api(`/api/log/search?${params}`)
        const rows = (data.rows || []).map((row) => this.decorate(row))
        if (append) {
          this.state.rows = [...this.state.rows, ...rows]
        } else {
          this.state.rows = rows
        }
        this.state.kind = data.kind
        this.state.loaded = true
        this.state.error = ''
      } catch (error) {
        this.state.error = error.message
      } finally {
        this.state.busy = false
        if (this.state.page) this.syncUrl()
      }
    }

    decorate(row) {
      row.timeLabel = new Date(row.time).toLocaleString()
      row.statusClass = row.status ? `s${Math.floor(row.status / 100)}` : ''
      row.levelLower = (row.level || '').toLowerCase()
      return row
    }

    loadOlder() {
      if (!this.state.rows.length) return
      this.state.before = this.state.rows[this.state.rows.length - 1].time
      this.load({ append: true })
    }

    pickRange(value) {
      this.state.range = value
      this.load()
    }

    pickLevel(value) {
      this.state.level = value
      this.load()
    }

    pickMethod(value) {
      this.state.method = value
      this.load()
    }

    pickStatus(value) {
      this.state.status = value
      this.load()
    }

    queueSearch() {
      clearTimeout(this.state.queryTimer)
      this.state.queryTimer = setTimeout(() => {
        this.state.query = this.state.queryNode ? this.state.queryNode.value.trim() : ''
        this.load()
      }, 250)
    }

    searchKey(event) {
      if (event.key !== 'Enter') return
      clearTimeout(this.state.queryTimer)
      this.state.query = this.state.queryNode ? this.state.queryNode.value.trim() : ''
      this.load()
    }

    clearFilters() {
      this.state.level = ''
      this.state.method = ''
      this.state.status = ''
      this.state.query = ''
      if (this.state.queryNode) this.state.queryNode.value = ''
      this.load()
    }

    rowKey(row) {
      return `${row.time}|${row.source || row.method || ''}|${row.process || row.path || ''}|${row.message || row.status || ''}`
    }

    expand(index) {
      const row = this.state.rows[index]
      if (!row) return
      const key = this.rowKey(row)
      this.state.expandedKey = this.state.expandedKey === key ? '' : key
    }

    copyRow(index) {
      const row = this.state.rows[index]
      if (!row) return
      navigator.clipboard?.writeText(row.raw || row.message || JSON.stringify(row)).then(
        () => Toast.show('Row copied'),
        () => Toast.show('Clipboard unavailable', true),
      )
    }

    detail(row) {
      return JSON.stringify(row, null, 2)
    }

    highlight(text) {
      const escaped = this.escapeHtml(text == null ? '' : String(text))
      const tokens = (this.state.query || '').split(/\s+/).filter(Boolean)
      if (!tokens.length) return escaped
      const pattern = tokens.map((token) => token.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')
      return escaped.replace(new RegExp(`(${pattern})`, 'gi'), '<mark>$1</mark>')
    }

    escapeHtml(text) {
      return text.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character])
    }

    downloadUrl() {
      const params = new URLSearchParams({ app: this.state.app, channel: this.state.channel })
      const since = this.since()
      if (since) params.set('since', since)
      if (this.state.query) params.set('q', this.state.query)
      if (this.state.level) params.set('level', this.state.level)
      if (this.state.method) params.set('method', this.state.method)
      if (this.state.status) params.set('status', this.state.status)
      return `/logs.txt?${params}`
    }

    syncUrl() {
      this.setQs('app', this.state.app)
      this.setQs('channel', this.state.channel)
      this.setQs('range', this.state.range === '1h' ? '' : this.state.range)
      this.setQs('level', this.state.level)
      this.setQs('method', this.state.method)
      this.setQs('status', this.state.status)
      this.setQs('q', this.state.query)
    }

    setQs(key, value) {
      if ((Fez.hqs(key) || '') === (value || '')) return
      Fez.hqs(key, value || null, { replace: true })
    }

    shortcut(event) {
      const tag = event.target.tagName
      if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') {
        if (event.key === 'Escape') event.target.blur()
        return
      }
      if (event.key === '/') {
        event.preventDefault()
        this.state.queryNode?.focus()
      } else if (event.key === 'r') {
        this.load()
      } else if (event.key === 'Escape') {
        this.state.expandedKey = ''
      }
    }
  }
</script>

<section class="log-view" class:log-view-page={state.page}>
  <nav class="log-nav" aria-label="Apps">
    {#each state.tree as group, appIndex}
      <div class="log-nav-group">
        <div class="log-nav-app" class:current={group.name === state.app}>
          <span class="log-nav-name">{appLabel(group.name)}</span>
          <span class="log-nav-size">{bytes(group.bytes)}</span>
        </div>
        <div class="log-nav-logs">
          {#each group.channels as channel, channelIndex}
            <button class="log-nav-log" class:active={group.name === state.app && channel.id === state.channel} type="button" onclick="fez.pickService({appIndex},{channelIndex})">
              {serviceLabel(channel, group.name)}
            </button>
          {:else}
            <span class="log-nav-empty text-muted">No logs</span>
          {/each}
        </div>
      </div>
    {:else}
      <p class="log-nav-empty text-muted">Loading...</p>
    {/each}
  </nav>
  <div class="log-main">
  <div class="log-toolbar">
    <div class="log-toolbar-row">
      <select class="log-control" fez:this="rangeNode" aria-label="Time range" onchange="fez.pickRange(this.value)">
        {#each [['5m', 'Last 5 min'], ['15m', 'Last 15 min'], ['1h', 'Last hour'], ['6h', 'Last 6 hours'], ['24h', 'Last 24 hours'], ['7d', 'Last 7 days'], ['all', 'All time']] as option}
          <option value={option[0]} selected={option[0] === state.range}>{option[1]}</option>
        {/each}
      </select>
      {#if isRequest()}
        <select class="log-control" fez:this="methodNode" aria-label="Method" onchange="fez.pickMethod(this.value)">
          <option value="">Any method</option>
          {#each ['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'HEAD', 'OPTIONS'] as method}
            <option value={method} selected={method === state.method}>{method}</option>
          {/each}
        </select>
        <select class="log-control" fez:this="statusNode" aria-label="Status" onchange="fez.pickStatus(this.value)">
          <option value="">Any status</option>
          {#each ['2xx', '3xx', '4xx', '5xx'] as status}
            <option value={status} selected={status === state.status}>{status}</option>
          {/each}
        </select>
      {:else}
        <select class="log-control" fez:this="levelNode" aria-label="Level" onchange="fez.pickLevel(this.value)">
          <option value="">All levels</option>
          {#each ['fatal', 'error', 'warn', 'info', 'debug'] as level}
            <option value={level} selected={level === state.level}>{level}</option>
          {/each}
        </select>
      {/if}
    </div>
    <div class="log-toolbar-row">
      <label class="log-search">
        <svg class="icon"><use href="#i-search"></use></svg>
        <input fez:this="queryNode" placeholder={isRequest() ? 'Search host, path, IP, agent or Ray ID' : 'Search (prefix match)'} oninput="fez.queueSearch()" onkeydown="fez.searchKey(event)">
      </label>
      <button class="btn btn-sm" type="button" onclick="fez.clearFilters()">Clear</button>
      <span class="log-spacer"></span>
      <button class="btn btn-sm" type="button" onclick="fez.load()" title="Refresh (r)">
        <svg class="icon"><use href="#i-refresh"></use></svg>
        Refresh
      </button>
      <a class="btn btn-sm" href={downloadUrl()} target="_blank" rel="noreferrer" title="Download as text">
        <svg class="icon"><use href="#i-download"></use></svg>
        Export
      </a>
    </div>
  </div>

  {#if state.error}
    <div class="config-message error" role="status">{state.error}</div>
  {/if}

  <div class="log-scroll">
    <table class="log-table">
      <thead>
        {#if state.kind === 'request'}
          <tr>
            <th>Time</th>
            <th>Method</th>
            <th>Status</th>
            <th>Path</th>
            <th class="num">ms</th>
            <th class="num">Bytes</th>
            <th>Geo</th>
            <th>IP</th>
          </tr>
        {:else}
          <tr>
            <th>Time</th>
            <th>Level</th>
            <th>Process</th>
            <th>Message</th>
          </tr>
        {/if}
      </thead>
      <tbody>
        {#each state.rows as row, index}
          <tr class="log-row" class:log-row-open={state.expandedKey === rowKey(row)} onclick="fez.expand({index})">
            {#if state.kind === 'request'}
              <td class="log-time">{row.timeLabel}</td>
              <td class="log-method">{row.method}</td>
              <td><span class="log-status" data-status={row.statusClass}>{row.status}</span></td>
              <td class="log-path">{row.path}</td>
              <td class="num">{row.duration_ms}</td>
              <td class="num">{row.bytes_out}</td>
              <td class="log-ip">{row.country}</td>
              <td class="log-ip">{row.ip}</td>
            {:else}
              <td class="log-time">{row.timeLabel}</td>
              <td><span class="log-level" data-level={row.levelLower}>{row.level || '-'}</span></td>
              <td class="log-process">{row.process}</td>
              <td class="log-message">{@html highlight(row.message)}</td>
            {/if}
          </tr>
          {#if state.expandedKey === rowKey(row)}
            <tr class="log-detail-row">
              <td colspan="8">
                <div class="log-detail-head">
                  <strong>{row.process || row.method || 'row'}</strong>
                  <button class="btn btn-sm" type="button" onclick="fez.copyRow({index})">Copy</button>
                </div>
                <pre class="log-detail">{detail(row)}</pre>
              </td>
            </tr>
          {/if}
        {:else}
          <tr>
            <td colspan="8" class="text-muted log-empty">{state.loaded ? 'No matching rows' : 'Loading...'}</td>
          </tr>
        {/each}
      </tbody>
    </table>
  </div>

  <div class="log-footer">
    <button class="btn btn-sm" type="button" onclick="fez.loadOlder()" disabled={!state.rows.length || state.busy}>Load older</button>
    <span class="text-muted">{state.rows.length} rows</span>
    {#if state.busy}
      <span class="spinner" aria-hidden="true"></span>
    {/if}
  </div>
  </div>
</section>
