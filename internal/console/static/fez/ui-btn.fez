<script>
  class {
    // an href makes it a real link; without one it is a span the onclick drives
    NAME = (node) => (node.getAttribute('href') ? 'a' : 'span')

    PROPS = {
      icon: String,
      label: String,
      class: String,
      disabled: Boolean,
    }

    // No template block on purpose: the root is written once, here. Every attribute is
    // part of an unkeyed component's identity, so a changed label or disabled state makes
    // the differ drop this instance and connect a fresh one that paints the new state.
    init(props) {
      const root = this.root
      this.on(root, 'keydown', (event) => this.onKeydown(event))

      // onclick arrives already rewritten to Fez(<parent uid>).method(), so the
      // attribute stays bound to the component that declared it.
      this.copy('href', 'title', 'target', 'rel', 'onclick')
      root.className = [root.className, 'btn', props.class, props.disabled ? 'disabled' : ''].filter(Boolean).join(' ')
      root.textContent = props.label || ''
      if (props.icon) {
        root.insertAdjacentHTML('afterbegin', `<svg class="icon"><use href="#${props.icon}"></use></svg>`)
      }

      // a span is not focusable or keyboard-operable, unlike the <button> it replaces
      if (root.tagName === 'SPAN') {
        root.setAttribute('role', 'button')
        root.setAttribute('tabindex', props.disabled ? '-1' : '0')
      }
      if (props.disabled) {
        root.setAttribute('aria-disabled', 'true')
      }
    }

    // A span carries no native activation, so Enter and Space have to fire the click.
    onKeydown(event) {
      if (event.key !== 'Enter' && event.key !== ' ') return
      if (this.root.tagName !== 'SPAN' || this.props.disabled) return
      event.preventDefault()
      this.root.click()
    }
  }
</script>
