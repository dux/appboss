<script>
  class {
    init() {
      this.state.apps = []
      this.state.app = Fez.hqs('app') || ''
      this.state.range = Fez.hqs('range') || '24h'
      this.state.traffic = null
      this.state.totals = {}
      this.state.columns = []
      this.state.peak = 0
      this.state.loading = false
      this.state.error = ''
      this.state.needsSelectSync = false
    }

    onMount() {
      this.load()
    }

    // The selects are fez:this refs: their live value is set after the options render, never on
    // every pass, so picking an app or a range never fights a re-render.
    afterRender() {
      if (!this.state.needsSelectSync) return
      this.state.needsSelectSync = false
      if (this.state.appSelect) this.state.appSelect.value = this.state.app
      if (this.state.rangeSelect) this.state.rangeSelect.value = this.state.range
    }

    async load() {
      this.state.loading = true
      try {
        const fleet = await Dboss.api('/api/apps')
        this.state.apps = (fleet.apps || []).map((app) => app.name).sort()
        if (!this.state.apps.includes(this.state.app)) this.state.app = this.state.apps[0] || ''
        Dboss.setQs('app', this.state.app)
        this.state.needsSelectSync = true
        if (this.state.app) {
          const params = new URLSearchParams({ app: this.state.app, range: this.state.range })
          const data = await Dboss.api(`/api/traffic?${params}`)
          this.shape(data.traffic)
        }
        this.state.error = ''
      } catch (error) {
        this.state.error = error.message
      } finally {
        this.state.loading = false
      }
    }

    pickApp(name) {
      this.state.app = name
      Dboss.setQs('app', name)
      this.load()
    }

    pickRange(value) {
      this.state.range = value
      Dboss.setQs('range', value === '24h' ? '' : value)
      this.load()
    }

    // shape derives the chart columns once per load, so a render only reads them.
    shape(traffic) {
      const series = traffic.series || []
      const peak = series.reduce((max, bucket) => Math.max(max, bucket.s2 + bucket.s3 + bucket.s4 + bucket.s5), 0)
      this.state.columns = series.map((bucket) => {
        const total = bucket.s2 + bucket.s3 + bucket.s4 + bucket.s5
        return {
          style: `height: ${peak ? Math.max(total ? 2 : 0, (total / peak) * 100) : 0}%`,
          title: `${this.bucketLabel(bucket.time, traffic.bucket)} · ${this.number(total)} requests · ${this.number(bucket.s5)} 5xx`,
          parts: ['s5', 's4', 's3', 's2'].filter((key) => bucket[key] > 0).map((key) => ({ key, style: `flex-grow: ${bucket[key]}` })),
        }
      })
      this.state.peak = peak
      this.state.totals = traffic.totals || {}
      this.state.traffic = traffic
    }

    bucketLabel(value, bucket) {
      const date = new Date(value)
      if (bucket === 'day') return date.toLocaleDateString([], { month: 'short', day: 'numeric' })
      if (bucket === 'hour') return date.toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
      return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    }

    edgeLabel(last) {
      const series = (this.state.traffic && this.state.traffic.series) || []
      if (!series.length) return ''
      return this.bucketLabel(series[last ? series.length - 1 : 0].time, this.state.traffic.bucket)
    }

    number(value) {
      return new Intl.NumberFormat().format(Math.round(Number(value || 0)))
    }

    ms(value) {
      const amount = Number(value || 0)
      return amount >= 1000 ? `${(amount / 1000).toFixed(amount >= 10000 ? 0 : 1)} s` : `${Math.round(amount)} ms`
    }

    bytes(value) {
      let amount = Number(value || 0)
      if (amount < 1024) return `${amount} B`
      const units = ['KB', 'MB', 'GB', 'TB']
      let unit = units[0]
      amount /= 1024
      for (let index = 1; amount >= 1024 && index < units.length; index += 1) {
        amount /= 1024
        unit = units[index]
      }
      return `${amount >= 10 ? amount.toFixed(0) : amount.toFixed(1)} ${unit}`
    }

    errorRate() {
      const totals = this.state.totals
      if (!totals.count) return '0%'
      const rate = (totals.errors * 100) / totals.count
      return `${rate >= 10 || rate === 0 ? rate.toFixed(0) : rate.toFixed(1)}%`
    }

    errorLevel() {
      const totals = this.state.totals
      const rate = totals.count ? (totals.errors * 100) / totals.count : 0
      if (rate >= 10) return 'danger'
      if (rate >= 2) return 'warn'
      return 'ok'
    }

    share(count) {
      const total = Number(this.state.totals.count || 0)
      return `width: ${total ? Math.max(1, (count / total) * 100) : 0}%`
    }

    slowShare(avg) {
      const slowest = (this.state.traffic.slowest[0] || {}).avg_ms || 0
      return `width: ${slowest ? Math.max(1, (avg / slowest) * 100) : 0}%`
    }

    statusClass(code) {
      return `s${Math.floor(Number(code) / 100)}`
    }

    // logsLink opens the #/logs route filtered to one value of the current view.
    logsLink(key, value) {
      const params = new URLSearchParams({ app: this.state.app, channel: 'request', range: this.state.range === '30d' ? 'all' : this.state.range })
      params.set(key, value)
      return `/#/logs?${params}`
    }
  }
</script>

<div class="page-header">
  <div>
    <p class="page-pretitle">Traffic</p>
    <h1 class="page-title">Requests &amp; latency</h1>
  </div>
  <div class="page-actions traffic-filters">
    <select fez:this="appSelect" aria-label="App" onchange="fez.pickApp(this.value)">
      {#each state.apps as name}
        <option value={name}>{name}</option>
      {/each}
    </select>
    <select fez:this="rangeSelect" aria-label="Range" onchange="fez.pickRange(this.value)">
      <option value="1h">Last hour</option>
      <option value="24h">Last 24 hours</option>
      <option value="7d">Last 7 days</option>
      <option value="30d">Last 30 days</option>
    </select>
    <button class="btn" type="button" onclick="fez.load()" disabled={state.loading}>
      <svg class="icon"><use href="#i-refresh"></use></svg>
      {state.loading ? 'Loading' : 'Refresh'}
    </button>
  </div>
</div>

{#if state.error}
  <div class="alert alert-danger">{state.error}</div>
{/if}

{#if !state.traffic}
  <div class="card empty-state">
    {#if state.loading}
      <span class="spinner" aria-hidden="true"></span>
      <strong>Reading the request log</strong>
    {:else}
      <strong>No app to show</strong>
      <span>Traffic appears once an app has served a request.</span>
    {/if}
  </div>
{:else}
  <section class="stat-row" aria-label="Traffic summary">
    <article class="card stat-card">
      <span class="subheader">Requests</span>
      <strong class="stat-value">{number(state.totals.count)}</strong>
      <span class="text-muted">peak {number(state.peak)} per {state.traffic.bucket}</span>
    </article>
    <article class="card stat-card">
      <span class="subheader">Error rate</span>
      <strong class="stat-value" class:text-danger={errorLevel() === 'danger'}>{errorRate()}</strong>
      <span class="text-muted">{number(state.totals.errors)} answers with 5xx</span>
    </article>
    <article class="card stat-card">
      <span class="subheader">Latency p95</span>
      <strong class="stat-value">{ms(state.totals.p95)}</strong>
      <span class="text-muted">p50 {ms(state.totals.p50)} · p99 {ms(state.totals.p99)}</span>
    </article>
    <article class="card stat-card">
      <span class="subheader">Bytes out</span>
      <strong class="stat-value">{bytes(state.totals.bytes_out)}</strong>
      <span class="text-muted">response bodies sent</span>
    </article>
  </section>

  <div class="section-head">
    <h2>Requests over time</h2>
    <div class="traffic-legend">
      <span data-status="s2">2xx</span>
      <span data-status="s3">3xx</span>
      <span data-status="s4">4xx</span>
      <span data-status="s5">5xx</span>
    </div>
  </div>
  <section class="card traffic-chart-card">
    {#if state.peak}
      <div class="traffic-chart" role="img" aria-label="Requests per {state.traffic.bucket}, stacked by status class">
        {#each state.columns as column}
          <div class="traffic-slot" title={column.title}>
            <div class="traffic-col" style={column.style}>
              {#each column.parts as part}
                <span data-status={part.key} style={part.style}></span>
              {/each}
            </div>
          </div>
        {/each}
      </div>
      <div class="traffic-axis">
        <span>{edgeLabel(false)}</span>
        <span>{edgeLabel(true)}</span>
      </div>
    {:else}
      <div class="traffic-none">No requests in this range.</div>
    {/if}
  </section>

  <div class="traffic-grid">
    <div>
      <div class="section-head">
        <h2>Top paths</h2>
      </div>
      <section class="card traffic-list traffic-paths">
        <div class="sys-row sys-head">
          <span class="subheader">Path</span>
          <span class="subheader num">Requests</span>
          <span class="subheader num">5xx</span>
          <span class="subheader num">Avg</span>
          <span class="subheader">Share</span>
        </div>
        {#each state.traffic.paths as row}
          <div class="sys-row">
            <a class="service-name traffic-key" href={logsLink('q', row.path)} target="_blank" rel="noreferrer" title={row.path}>{row.path}</a>
            <span class="num">{number(row.count)}</span>
            <span class="num" class:text-danger={row.errors > 0}>{number(row.errors)}</span>
            <span class="num">{ms(row.avg_ms)}</span>
            <span class="meter"><span style={share(row.count)}></span></span>
          </div>
        {:else}
          <div class="sys-row sys-empty text-muted">No requests in this range.</div>
        {/each}
      </section>
    </div>

    <div>
      <div class="section-head">
        <h2>Slowest paths</h2>
      </div>
      <section class="card traffic-list traffic-paths">
        <div class="sys-row sys-head">
          <span class="subheader">Path</span>
          <span class="subheader num">Requests</span>
          <span class="subheader num">Max</span>
          <span class="subheader num">Avg</span>
          <span class="subheader">Relative</span>
        </div>
        {#each state.traffic.slowest as row}
          <div class="sys-row">
            <a class="service-name traffic-key" href={logsLink('q', row.path)} target="_blank" rel="noreferrer" title={row.path}>{row.path}</a>
            <span class="num">{number(row.count)}</span>
            <span class="num">{ms(row.max_ms)}</span>
            <span class="num">{ms(row.avg_ms)}</span>
            <span class="meter" data-level="warn"><span style={slowShare(row.avg_ms)}></span></span>
          </div>
        {:else}
          <div class="sys-row sys-empty text-muted">No path with 5 or more requests yet.</div>
        {/each}
      </section>
    </div>

    <div>
      <div class="section-head">
        <h2>Status codes</h2>
      </div>
      <section class="card traffic-list traffic-counts">
        {#each state.traffic.statuses as row}
          <div class="sys-row">
            <a class="traffic-key" href={logsLink('status', row.key)} target="_blank" rel="noreferrer"><span class="log-status" data-status={statusClass(row.key)}>{row.key}</span></a>
            <span class="num">{number(row.count)}</span>
            <span class="meter"><span style={share(row.count)}></span></span>
          </div>
        {:else}
          <div class="sys-row sys-empty text-muted">No requests in this range.</div>
        {/each}
      </section>
    </div>

    <div>
      <div class="section-head">
        <h2>Countries</h2>
      </div>
      <section class="card traffic-list traffic-counts">
        {#each state.traffic.countries as row}
          <div class="sys-row">
            <span class="service-name">{row.key}</span>
            <span class="num">{number(row.count)}</span>
            <span class="meter"><span style={share(row.count)}></span></span>
          </div>
        {:else}
          <div class="sys-row sys-empty text-muted">No country data. It comes from Cloudflare's CF-IPCountry header.</div>
        {/each}
      </section>
    </div>

    <div>
      <div class="section-head">
        <h2>Client IPs</h2>
      </div>
      <section class="card traffic-list traffic-counts">
        {#each state.traffic.ips as row}
          <div class="sys-row">
            <a class="service-name traffic-key" href={logsLink('q', row.key)} target="_blank" rel="noreferrer">{row.key}</a>
            <span class="num">{number(row.count)}</span>
            <span class="meter"><span style={share(row.count)}></span></span>
          </div>
        {:else}
          <div class="sys-row sys-empty text-muted">No requests in this range.</div>
        {/each}
      </section>
    </div>

    <div>
      <div class="section-head">
        <h2>Methods</h2>
      </div>
      <section class="card traffic-list traffic-counts">
        {#each state.traffic.methods as row}
          <div class="sys-row">
            <a class="service-name traffic-key" href={logsLink('method', row.key)} target="_blank" rel="noreferrer">{row.key}</a>
            <span class="num">{number(row.count)}</span>
            <span class="meter"><span style={share(row.count)}></span></span>
          </div>
        {:else}
          <div class="sys-row sys-empty text-muted">No requests in this range.</div>
        {/each}
      </section>
    </div>
  </div>
{/if}
