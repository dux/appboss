<script>
  class {
    PROPS = {
      app: { type: Object, required: true },
    }

    init() {
      this.state.hookMeta = {}
      this.state.pending = false
    }

    onMount() {
      this.loadHooks()
    }

    async loadHooks() {
      try {
        const data = await Dboss.api(`/api/hooks?app=${encodeURIComponent(this.props.app.name)}`)
        const meta = {}
        for (const hook of data.hooks || []) meta[hook.name] = hook
        this.state.hookMeta = meta
      } catch (error) {
        this.state.hookMeta = {}
      }
    }

    beforeRender() {
      const app = this.props.app
      const webs = app.web_processes || []
      const primary = webs.find((web) => web.canonical_host) || webs[0]
      const host = ((primary && (primary.canonical_host || (primary.hosts || [])[0])) || (app.hosts || [])[0] || '').replace(/^\*?\./, '')
      // The proxy's address, not the page's: the console has its own listener.
      const scheme = this.globalState.appScheme
      const port = this.globalState.appPort
      this.state.serviceUrl = host && scheme ? `${scheme}://${host}${port ? `:${port}` : ''}` : ''
      this.state.changing = app.state === 'starting' || app.state === 'stopping'
      this.state.live = app.state === 'running' || app.state === 'starting'
      this.state.processes = app.processes || []
      const hubs = (app.web_processes || []).filter((web) => web.pubsub && web.pubsub.path)
      this.state.pubsub = hubs.map((web) => `${web.name} ${web.pubsub.path}`)
      this.state.cron = app.cron || []
      this.state.hooks = (app.hooks || []).map((hook) => ({ ...hook, url: this.state.hookMeta[hook.name]?.url || '' }))
      this.state.errorLog = (app.error_log || []).join('\n')
    }

    number(value) {
      return new Intl.NumberFormat().format(Number(value || 0))
    }

    bytes(value) {
      let amount = Number(value || 0)
      if (amount < 1024) return `${amount} B`
      const units = ['KB', 'MB', 'GB', 'TB']
      let unit = units[0]
      amount /= 1024
      for (let index = 1; amount >= 1024 && index < units.length; index += 1) {
        amount /= 1024
        unit = units[index]
      }
      return `${amount >= 10 ? amount.toFixed(0) : amount.toFixed(1)} ${unit}`
    }

    hasTime(value) {
      return Boolean(value) && !String(value).startsWith('0001-')
    }

    activity(value) {
      if (!this.hasTime(value)) return 'No traffic'
      const seconds = Math.round((Date.now() - new Date(value).getTime()) / 1000)
      if (seconds < 10) return 'Just now'
      if (seconds < 60) return `${seconds}s ago`
      if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`
      if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`
      return `${Math.floor(seconds / 86400)}d ago`
    }

    // A stop drains first, so the daemon can take seconds to answer: the row reads as pending
    // from the click. A cancelled confirm and a failed call never reach a snapshot, so the flag,
    // not the next render, is what gives the buttons back.
    async act(action) {
      this.state.pending = true
      try {
        await Dboss.runAction(this.props.app.name, action)
      } finally {
        this.state.pending = false
      }
    }

    // Same as act, narrowed to one procfile process; the rest of the app keeps running.
    async actProcess(action, name) {
      this.state.pending = true
      try {
        await Dboss.runAction(this.props.app.name, action, { process: name })
      } finally {
        this.state.pending = false
      }
    }

    clock(value) {
      if (!this.hasTime(value)) return '-'
      const date = new Date(value)
      if (isNaN(date.getTime())) return '-'
      const seconds = Math.round((date.getTime() - Date.now()) / 1000)
      if (Math.abs(seconds) < 5) return 'now'
      if (seconds > 0) {
        if (seconds < 60) return `in ${seconds}s`
        if (seconds < 3600) return `in ${Math.round(seconds / 60)}m`
        if (seconds < 86400) return `in ${Math.round(seconds / 3600)}h`
        return `in ${Math.round(seconds / 86400)}d`
      }
      const past = -seconds
      if (past < 60) return `${past}s ago`
      if (past < 3600) return `${Math.round(past / 60)}m ago`
      if (past < 86400) return `${Math.round(past / 3600)}h ago`
      return `${Math.round(past / 86400)}d ago`
    }

    diskLabel() {
      const disk = this.props.app.disk
      if (!this.hasTime(disk?.measured_at)) return '-'
      return this.bytes(disk.total_bytes)
    }

    diskTitle() {
      const disk = this.props.app.disk
      if (!this.hasTime(disk?.measured_at)) return 'Not measured yet - click to measure now'
      return `app ${this.bytes(disk.app_bytes)} + logs ${this.bytes(disk.log_bytes)}, measured ${this.clock(disk.measured_at)} - click to re-measure`
    }

    // The value is measured once a day, so an operator who just cleaned up asks for a fresh walk
    // here. The shell owns the app list, so the answer is picked up by a normal reload.
    async measureDisk() {
      try {
        await Dboss.api('/api/disk/refresh', { method: 'POST', body: JSON.stringify({ app: this.props.app.name }) })
        await Dboss.reload()
        Toast.show(`${this.props.app.name}: disk measured`)
      } catch (error) {
        Toast.show(error.message, true)
      }
    }

    lastRun(job) {
      if (job.running) return 'running'
      if (job.last_error) return job.last_error
      if (this.hasTime(job.last_end)) return `exit ${job.last_exit} ${this.clock(job.last_end)}`
      return '-'
    }

    runCron(job) {
      Dboss.runAction(this.props.app.name, 'cron-run', { job: job.name })
    }

    async runHook(hook) {
      try {
        await Dboss.api('/api/hooks/run', { method: 'POST', body: JSON.stringify({ app: this.props.app.name, hook: hook.name }) })
        Toast.show(`${this.props.app.name}: ${hook.name} started`)
        this.loadHooks()
      } catch (error) {
        Toast.show(error.message, true)
      }
    }

    async copy(value) {
      if (!value) {
        Toast.show('Set tokens.dboss and management.host to get a ping URL', true)
        return
      }
      try {
        await navigator.clipboard.writeText(value)
        Toast.show('Ping URL copied')
      } catch (error) {
        Toast.show(value)
      }
    }
  }
</script>

<article class="card app-card" data-state={props.app.state}>
  <div class="card-header">
    <span class="app-icon" aria-hidden="true"><svg class="icon"><use href="#i-server"></use></svg></span>
    <div class="app-identity">
      <h3 class="app-name"><a href="#/logs?app={props.app.name}" title="Open the logs of {props.app.name}">{props.app.name}</a>{#if props.app.branch_url} <a class="app-branch" href={props.app.branch_url} target="_blank" rel="noreferrer" title="Open {props.app.branch} on the git host">git:{props.app.branch}</a>{:else if props.app.branch} <span class="app-branch">git:{props.app.branch}</span>{/if}</h3>
      {#if state.serviceUrl}
        <a class="service-link" href={state.serviceUrl} target="_blank" rel="noreferrer"><span class="service-url">{state.serviceUrl}</span><svg class="icon"><use href="#i-external"></use></svg></a>
      {:else}
        <span class="service-host">No hosts configured</span>
      {/if}
    </div>
    <div class="app-status">
      <span class="badge">{props.app.state}</span>
      {#if state.pubsub.length}
        <a class="badge badge-success badge-pubsub" href="#/pubsub" title="Realtime hub: {state.pubsub.join(', ')}">PubSub</a>
      {/if}
      {#if props.app.maintenance}
        <span class="badge badge-warning">maintenance</span>
      {/if}
      {#if props.app.wake_button}
        <span class="badge" title="Start it from the console or its start page">manual</span>
      {/if}
      {#if props.app.draining}
        <span class="badge badge-warning">draining</span>
      {/if}
      {#if props.app.rolling}
        <span class="badge badge-warning" title="New copies start next to the old ones and take over once healthy; the app keeps serving">rolling restart</span>
      {/if}
    </div>
    <div class="btn-list app-actions">
      <ui-btn class="btn-sm" icon="i-file-text" label="Logs" href="#/logs?app={props.app.name}" />
      <ui-btn class="btn-sm" icon="i-activity" label="Traffic" href="#/traffic?app={props.app.name}" title="Request traffic for this app" />
      <ui-btn class="btn-sm" icon="i-settings" label="Config" href="#/config?id=app:{props.app.name}" title="Edit this app's dboss.yaml" />
      <ui-btn class="btn-sm {props.app.maintenance ? 'btn-warning' : ''}" icon="i-tool" label={props.app.maintenance ? 'End maintenance' : 'Maintenance'} onclick="fez.act('{props.app.maintenance ? 'maintenance-off' : 'maintenance-on'}')" disabled={state.pending} title={props.app.maintenance ? 'Serve the app again' : 'Answer every request with the maintenance page'} />
      <ui-btn class="btn-sm" icon="i-play" label="Start" onclick="fez.act('start')" disabled={state.pending || props.app.state === 'running' || props.app.state === 'starting'} />
      <ui-btn class="btn-sm" icon="i-rotate" label="Restart" onclick="fez.act('restart')" disabled={state.pending || state.changing || props.app.state === 'stopped'} />
      <ui-btn class="btn-sm btn-outline-danger" icon="i-stop" label="Stop" onclick="fez.act('stop')" disabled={state.pending || state.changing || props.app.state === 'stopped'} />
      {#if props.app.deletable}
        <ui-btn class="btn-sm btn-outline-danger" icon="i-trash" label="Destroy" onclick="fez.act('destroy')" disabled={state.pending || state.changing} title="Permanently remove this app from dboss and disk" />
      {/if}
    </div>
  </div>

  <div class="app-stats">
    uptime: <b>{props.app.uptime || '-'}</b> &sdot;
    memory: <b>{bytes(props.app.resources?.memory_bytes)}</b> &sdot;
    disk: <b class="stat-action" title={diskTitle()} onclick="fez.measureDisk()">{diskLabel()}</b> &sdot;
    last activity: <b>{activity(props.app.last_activity)}</b> &sdot;
    requests / hour: <b>{number(props.app.request_rates?.last_hour)}</b>
  </div>

  {#if props.app.error}
    <div class="alert alert-danger app-error">
      <svg class="icon"><use href="#i-alert"></use></svg>
      <div>
        <strong>{props.app.error}</strong>
        {#if state.errorLog}
          <span class="error-log-label">Last 1000 log lines</span>
          <pre class="error-log">{state.errorLog}</pre>
        {/if}
      </div>
    </div>
  {/if}

  <div class="service-list">
    <div class="service-row service-head">
      <span class="subheader">Service</span>
      <span class="subheader">State</span>
      <span class="subheader">Port</span>
      <span class="subheader">PID</span>
      <span class="subheader">Restarts</span>
      <span class="subheader">Memory</span>
      <span></span>
    </div>
    {#each state.processes as process}
      <div class="service-row" data-state={process.state}>
        <a class="service-name service-log-link" href="#/logs?app={props.app.name}&channel=stdout:{process.name}" title="Open {process.name} logs">{process.name}</a>
        <span class="badge">{process.state}</span>
        <span class="service-value">{process.port || '-'}</span>
        <span class="service-value">{process.pid || '-'}</span>
        <span class="service-value">{process.restarts || 0}</span>
        <span class="service-value">{bytes(process.memory_bytes)}</span>
        <span class="service-actions">
          <ui-btn class="btn-sm btn-icon" icon="i-play" onclick="fez.actProcess('start', '{process.name}')" disabled={state.pending || !state.live || process.state === 'running'} title="Start {process.name}" />
          <ui-btn class="btn-sm btn-icon" icon="i-rotate" onclick="fez.actProcess('restart', '{process.name}')" disabled={state.pending || process.state !== 'running'} title="Restart {process.name}" />
          <ui-btn class="btn-sm btn-icon btn-outline-danger" icon="i-stop" onclick="fez.actProcess('stop', '{process.name}')" disabled={state.pending || process.state !== 'running'} title="Stop {process.name}" />
        </span>
      </div>
    {:else}
      <div class="service-row service-empty text-muted">No services in the procfile</div>
    {/each}
  </div>

  {#if state.cron.length}
    <div class="service-list">
      <div class="cron-row cron-head">
        <span class="subheader">Job</span>
        <span class="subheader">Schedule</span>
        <span class="subheader">Next</span>
        <span class="subheader">Last</span>
        <span></span>
      </div>
      {#each state.cron as job}
        <div class="cron-row" data-running={job.running ? 'true' : 'false'}>
          <span class="service-name">{job.name}{#if job.disabled} <span class="text-muted">(disabled)</span>{/if}</span>
          <span class="cron-schedule">{job.schedule}</span>
          <span class="service-value">{job.disabled ? '-' : clock(job.next)}</span>
          <span class="service-value">{lastRun(job)}</span>
          <button class="btn btn-sm" type="button" onclick="fez.runCron('{job.name}')" disabled={job.running || job.disabled} title="Run this job now">
            <svg class="icon"><use href="#i-play"></use></svg>
            Run
          </button>
        </div>
      {/each}
    </div>
  {/if}

  {#if state.hooks.length}
    <div class="service-list">
      <div class="hook-row hook-head">
        <span class="subheader">Hook</span>
        <span class="subheader">Last</span>
        <span class="subheader">Ping URL</span>
        <span></span>
      </div>
      {#each state.hooks as hook}
        <div class="hook-row" data-running={hook.running ? 'true' : 'false'}>
          <span class="service-name">{hook.name}{#if hook.disabled} <span class="text-muted">(disabled)</span>{/if}{#if hook.restart} <span class="text-muted">(restarts)</span>{/if}</span>
          <span class="service-value">{lastRun(hook)}</span>
          <span class="hook-url" title={hook.url}>{hook.url || 'set tokens.dboss and management.host'}</span>
          <span class="hook-actions">
            <button class="btn btn-sm" type="button" onclick={() => fez.copy(hook.url)} disabled={!hook.url} title="Copy the ping URL">
              <svg class="icon"><use href="#i-copy"></use></svg>
              Copy
            </button>
            <button class="btn btn-sm" type="button" onclick={() => fez.runHook(hook)} disabled={hook.running || hook.disabled} title="Run this hook now">
              <svg class="icon"><use href="#i-play"></use></svg>
              Run
            </button>
          </span>
        </div>
      {/each}
    </div>
  {/if}
</article>
