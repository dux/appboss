<script>
  class {
    MOUNT = true
    GLOBAL = 'Drawer'

    init() {
      this.state.open = false
      this.state.mode = 'text'
      this.state.title = ''
      this.state.text = ''
    }

    onMount() {
      this.on('keydown', (event) => {
        if (event.key === 'Escape' && this.state.open) this.close()
      })
    }

    open(title, text) {
      this.state.mode = 'text'
      this.state.title = title
      this.state.text = text
      this.state.open = true
    }

    openKeys() {
      this.state.mode = 'keys'
      this.state.title = 'Configuration keys'
      this.state.text = ''
      this.state.open = true
    }

    async showReference() {
      try {
        this.open('Configuration reference', await Boss.apiText('/api/config/reference'))
      } catch (error) {
        Toast.show(error.message, true)
      }
    }

    close() {
      this.state.open = false
    }
  }
</script>

<aside class="drawer" class:d-none={!state.open} aria-label={state.title}>
  {#if state.open}
    <div class="drawer-head">
      <strong>{state.title}</strong>
      <div class="btn-list">
        {#if state.mode === 'keys'}
          <button class="btn btn-sm" type="button" onclick="fez.showReference()">
            <svg class="icon"><use href="#i-book"></use></svg>
            Annotated reference
          </button>
        {/if}
        <button class="btn btn-ghost btn-icon" type="button" onclick="fez.close()" aria-label="Close">
          <svg class="icon"><use href="#i-x"></use></svg>
        </button>
      </div>
    </div>
    {#if state.mode === 'keys'}
      <ab-config-keys />
    {:else}
      <pre>{state.text}</pre>
    {/if}
  {/if}
</aside>
