<script>
  // The registry is static for a running daemon, so every instance shares one request.
  let registry = null

  const loadRegistry = () => {
    registry ||= Promise.all([
      Dboss.api('/api/config/keys'),
      Dboss.api('/api/config/blocks'),
    ]).catch((error) => {
      registry = null
      throw error
    })
    return registry
  }

  class {
    // paths="a, b" limits the list to those keys and drops the filter box
    PROPS = {
      paths: { type: Array, default: (raw) => (raw || '').split(/\s*,\s*/).filter(Boolean) },
    }

    init() {
      this.state.keys = []
      this.state.blocks = []
      this.state.query = ''
      this.state.groups = []
      this.load()
    }

    async load() {
      try {
        const [keys, blocks] = await loadRegistry()
        this.state.keys = keys
        this.state.blocks = blocks
      } catch (error) {
        Toast.show(error.message, true)
      }
    }

    beforeRender() {
      const query = this.state.query.trim().toLowerCase()
      const paths = this.props.paths
      const matches = (key) => paths.length
        ? paths.includes(key.path)
        : !query || key.path.includes(query) || key.description.toLowerCase().includes(query)
      this.state.groups = this.state.blocks
        .map((block) => ({ ...block, keys: this.state.keys.filter((key) => key.block === block.id && matches(key)) }))
        .filter((block) => block.keys.length)
    }

    filter(value) {
      this.state.query = value
    }

    note(scope) {
      if (scope === 'service') return 'root dboss.yaml'
      if (scope === 'app') return 'app dboss.yaml'
      return 'defaults: in the root file, top level in an app file'
    }
  }
</script>

<div class="keys" class:keys-embed={props.paths.length}>
  {#unless props.paths}
    <div class="keys-search">
      <input type="search" id="config-keys-filter" placeholder="Filter keys" aria-label="Filter keys" fez:keep="search" oninput="fez.filter(this.value)" />
    </div>
  {/unless}
  {#each state.groups as group}
    <section class="keys-group">
      <h3>{group.title} <small>{note(group.scope)}</small></h3>
      {#each group.keys as key}
        <div class="key-row">
          <div class="key-name">
            <code class="key-path">{key.path}</code>
            <span class="key-type">{key.type}</span>
          </div>
          <div class="key-desc">
            {key.description}
            {#if key.per_process}
              <span class="key-tag">per process</span>
            {/if}
            {#if key.default}
              <div class="key-value"><span class="text-muted">Default:</span> <code>{key.default}</code></div>
            {:else if key.example}
              <div class="key-value"><span class="text-muted">Example:</span> <code>{key.example}</code></div>
            {/if}
          </div>
        </div>
      {/each}
    </section>
  {:else}
    <div class="keys-empty">No keys match.</div>
  {/each}
</div>
