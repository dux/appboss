<script>
  class {
    init() {
      this.state.keys = []
      this.state.blocks = []
      this.state.query = ''
      this.state.groups = []
      this.load()
    }

    async load() {
      try {
        const [keys, blocks] = await Promise.all([
          Dboss.api('/api/config/keys'),
          Dboss.api('/api/config/blocks'),
        ])
        this.state.keys = keys
        this.state.blocks = blocks
      } catch (error) {
        Toast.show(error.message, true)
      }
    }

    beforeRender() {
      const query = this.state.query.trim().toLowerCase()
      const matches = (key) => !query || key.path.includes(query) || key.description.toLowerCase().includes(query)
      this.state.groups = this.state.blocks
        .map((block) => ({ ...block, keys: this.state.keys.filter((key) => key.block === block.id && matches(key)) }))
        .filter((block) => block.keys.length)
    }

    filter(value) {
      this.state.query = value
    }

    note(scope) {
      if (scope === 'service') return 'root dboss.yaml'
      if (scope === 'app') return 'app dboss.yaml'
      return 'defaults: in the root file, top level in an app file'
    }
  }
</script>

<div class="keys">
  <div class="keys-search">
    <input type="search" id="config-keys-filter" placeholder="Filter keys" aria-label="Filter keys" fez:keep="search" oninput="fez.filter(this.value)" />
  </div>
  {#each state.groups as group}
    <section class="keys-group">
      <h3>{group.title} <small>{note(group.scope)}</small></h3>
      {#each group.keys as key}
        <div class="key-row">
          <div class="key-name">
            <code class="key-path">{key.path}</code>
            <span class="key-type">{key.type}</span>
          </div>
          <div class="key-desc">
            {key.description}
            {#if key.per_process}
              <span class="key-tag">per process</span>
            {/if}
          </div>
          <div class="key-value">
            {#if key.default}
              <span class="text-muted">default</span>
              <code>{key.default}</code>
            {/if}
            {#if key.example}
              <span class="key-example"><span class="text-muted">e.g.</span> <code>{key.example}</code></span>
            {/if}
          </div>
        </div>
      {/each}
    </section>
  {:else}
    <div class="keys-empty">No keys match.</div>
  {/each}
</div>
