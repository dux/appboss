<script>
  class {
    GLOBAL = 'Dboss'

    ROUTES = [
      { name: 'overview', label: 'Overview', icon: 'i-home' },
      { name: 'logs', label: 'Logs', icon: 'i-list' },
      { name: 'traffic', label: 'Traffic', icon: 'i-activity' },
      { name: 'audit', label: 'Audit', icon: 'i-file-text' },
      { name: 'sys', label: 'Sys', icon: 'i-server' },
      { name: 'pg', label: 'PG SQL', icon: 'i-database', capability: 'pgAvailable' },
      { name: 'pubsub', label: 'PubSub', icon: 'i-broadcast', capability: 'pubsubAvailable' },
      { name: 'config', label: 'Config', icon: 'i-settings' },
      { name: 'help', label: 'Help', icon: 'i-help' },
    ]

    init() {
      this.state.route = Pjax.hpath() || 'overview'
      this.state.csrf = ''
      this.state.viewer = ''
      this.state.version = ''
      this.globalState.apps = []
      this.globalState.loaded = false
      this.globalState.busy = false
      this.globalState.status = 'Waiting for daemon'
      this.globalState.restartRequired = []
      this.globalState.pgAvailable = false
      this.globalState.pubsubAvailable = false
      this.globalState.devSession = false
      this.globalState.held = false
    }

    onMount() {
      this.syncRoute()
      this.on('hashchange', () => this.syncRoute())
      this.on('popstate', () => this.syncRoute())
      this.on(document, 'visibilitychange', () => {
        if (!document.hidden) this.reload({ quiet: true })
      })
      this.setInterval(() => this.reload({ quiet: true }), 5000)
      this.bootstrap()
    }

    // beforeRender filters the nav from the current capabilities, so the optional tabs follow a rescan.
    beforeRender() {
      this.state.visibleRoutes = this.ROUTES.filter(
        (route) => !route.capability || this.globalState[route.capability],
      )
    }

    // syncRoute maps the fragment onto a tpl-<name> component. A missing route (e.g. the bare
    // origin, or a stale #anchor) falls back to overview with a replace, never a history entry.
    syncRoute() {
      if (!Pjax.hpath()) Pjax.hpath('overview', { replace: true })
      this.navigate()
    }

    navigate() {
      const name = Pjax.hpath() || 'overview'
      this.state.route = name
      const tag = 'tpl-' + name
      const outlet = document.getElementById('route-outlet')
      if (!outlet) return
      if (Fez.index[tag]?.class) {
        outlet.innerHTML = Fez.tag(tag)
        return
      }
      outlet.innerHTML = '<p class="route-loading text-muted">Loading...</p>'
      Fez.head({ fez: '/assets/fez/' + tag + '.fez' }, () => {
        if (this.state.route !== name) return
        const target = document.getElementById('route-outlet')
        if (!target) return
        target.innerHTML = Fez.index[tag]?.class
          ? Fez.tag(tag)
          : '<p class="route-missing text-muted">Page not found.</p>'
      })
    }

    // readQs/setQs wrap the hash-route query so a page never has to build URLSearchParams.
    readQs(key, fallback = '') {
      return Pjax.hqs(key) ?? fallback
    }

    setQs(key, value, replace = true) {
      const next = value || ''
      if ((Pjax.hqs(key) || '') === next) return
      Pjax.hqs(key, next || null, { replace })
    }

    initials() {
      const name = (this.state.viewer || '').split('@')[0]
      return name ? name.slice(0, 2).toUpperCase() : '..'
    }

    async api(path, options = {}) {
      const headers = new Headers(options.headers || {})
      if (options.body && !(options.body instanceof FormData)) headers.set('Content-Type', 'application/json')
      if (options.method && options.method !== 'GET') headers.set('X-CSRF-Token', this.state.csrf)
      const response = await fetch(path, { ...options, headers })
      if (response.status === 401) {
        window.location.reload()
        throw new Error('Your session expired. Signing in again.')
      }
      if (response.status === 204) return null
      const data = await response.json()
      if (!response.ok) throw new Error(data.error || `Request failed with status ${response.status}`)
      return data
    }

    async apiText(path) {
      const response = await fetch(path)
      if (response.status === 401) {
        window.location.reload()
        throw new Error('Your session expired. Signing in again.')
      }
      if (!response.ok) {
        const data = await response.json().catch(() => ({}))
        throw new Error(data.error || `Request failed with status ${response.status}`)
      }
      return response.text()
    }

    applyApps(apps, updatedAt = new Date().toISOString(), capabilities = null) {
      const fleet = Array.isArray(apps) ? [...apps].sort((a, b) => a.name.localeCompare(b.name)) : []
      const time = new Date(updatedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })
      this.globalState.apps = fleet
      this.globalState.loaded = true
      this.globalState.status = `Updated ${time}`
      if (capabilities) {
        this.globalState.pgAvailable = Boolean(capabilities.postgres)
        this.globalState.pubsubAvailable = Boolean(capabilities.pubsub)
        this.globalState.devSession = Boolean(capabilities.dev)
        this.globalState.held = Boolean(capabilities.held)
      }
    }

    setBusy(busy) {
      this.globalState.busy = busy
    }

    async bootstrap() {
      try {
        const data = await this.api('/api/bootstrap')
        this.state.csrf = data.csrf
        this.state.viewer = data.viewer
        this.state.version = data.version || ''
        this.globalState.appScheme = data.app_scheme || ''
        this.globalState.appPort = data.app_port || ''
        this.applyApps(data.apps, data.updated_at, data.capabilities)
        this.globalState.restartRequired = data.restart_required || []
      } catch (error) {
        Toast.show(error.message, true)
      }
    }

    async reload({ quiet = false } = {}) {
      if (this.globalState.busy || document.hidden) return
      try {
        if (!quiet) this.setBusy(true)
        const data = await this.api('/api/apps')
        this.applyApps(data.apps, data.updated_at, data.capabilities)
      } catch (error) {
        this.globalState.status = 'Daemon unavailable'
        if (!quiet) Toast.show(error.message, true)
      } finally {
        if (!quiet) this.setBusy(false)
      }
    }

    async runAction(app, action, extra = {}) {
      if (this.globalState.busy) return
      const target = extra.process ? `${app}/${extra.process}` : app
      if (action === 'destroy') {
        const confirmation = window.prompt(`Destroy ${app} permanently?\n\nThis removes its app folder from disk. Type ${app} to confirm.`)
        if (confirmation !== app) return
      } else if (['stop', 'restart'].includes(action) && !window.confirm(`${action[0].toUpperCase()}${action.slice(1)} ${target}?`)) return
      try {
        this.setBusy(true)
        const data = await this.api('/api/action', { method: 'POST', body: JSON.stringify({ app, action, ...extra }) })
        this.applyApps(data.apps, data.updated_at)
        Toast.show(action === 'destroy' ? `${app} destroyed` : `${target}: ${action.replace('-', ' ')} requested`)
      } catch (error) {
        Toast.show(error.message, true)
      } finally {
        this.setBusy(false)
      }
    }

    async rescan() {
      if (this.globalState.busy) return
      try {
        this.setBusy(true)
        const data = await this.api('/api/rescan', { method: 'POST', body: '{}' })
        this.applyApps(data.apps)
        this.globalState.restartRequired = data.restart_required || []
        Fez.publish('config:changed')
        if (data.invalid?.length) {
          Toast.show(`Rescan finished with ${data.invalid.length} warning(s): ${data.invalid[0]}`, true)
        } else {
          Toast.show('App folders rescanned')
        }
      } catch (error) {
        Toast.show(error.message, true)
      } finally {
        this.setBusy(false)
      }
    }

    async logout() {
      if (this.globalState.busy) return
      try {
        this.setBusy(true)
        await this.api('/api/logout', { method: 'POST', body: '{}' })
        window.location.assign('/')
      } catch (error) {
        Toast.show(error.message, true)
        this.setBusy(false)
      }
    }
  }
</script>

{#if globalState.held}
  <div class="held-bar" role="alert">
    <svg class="icon"><use href="#i-alert"></use></svg>
    <span>Apps are on hold: press ENTER in the terminal running dboss start.</span>
  </div>
{/if}

<header class="navbar">
  <div class="container navbar-inner">
    <a class="brand" href="#/overview" aria-label="dboss home">
      <span class="brand-mark" aria-hidden="true"><svg class="icon"><use href="#i-terminal"></use></svg></span>
      <span class="brand-name">dboss</span>
      <span class="brand-version">{state.version}</span>
    </a>
    <div class="navbar-user">
      <span class="avatar" aria-hidden="true">{initials()}</span>
      <span class="user-block">
        <strong>{state.viewer || 'Connecting...'}</strong>
        <small>{globalState.devSession ? 'Local session' : 'Administrator'}</small>
      </span>
      {#unless globalState.devSession}
        <button class="btn btn-ghost" type="button" onclick="fez.logout()">
          <svg class="icon"><use href="#i-logout"></use></svg>
          Sign out
        </button>
      {/unless}
    </div>
  </div>
</header>

<nav class="navbar-tabs" aria-label="Sections">
  <div class="container">
    <ul class="nav-tabs">
      {#each state.visibleRoutes as item}
        <li>
          <a class="nav-link" class:active={item.name === state.route} href={'#/' + item.name}>
            <svg class="icon"><use href={'#' + item.icon}></use></svg>{item.label}
          </a>
        </li>
      {/each}
    </ul>
  </div>
</nav>
